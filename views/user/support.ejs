<link rel="stylesheet" href="/styles/user/support.css">

<div class="support-hero">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">How Can We Help?</h1>
        <p class="text-gray-400 text-sm max-w-xl">Our dedicated support team is here to assist you with any
            questions or concerns</p>
    </div>
</div>

<main class="max-w-7xl mx-auto px-4 -mt-10 mb-20 relative z-10">

    <!-- Top 4 Contact Blocks -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <div class="contact-block">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Phone Support</h3>
            <p class="text-sm font-semibold text-gray-700">+91 1800-123-4567</p>
            <p class="text-xs text-gray-500 mt-2">Mon-Sat, 9AM - 8PM IST</p>
        </div>

        <div class="contact-block">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Email Support</h3>
            <p class="text-sm font-semibold text-gray-700">support@zound.com</p>
            <p class="text-xs text-gray-500 mt-2">Response within 24 hours</p>
        </div>

        <div class="contact-block">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Visit Our Store</h3>
            <p class="text-sm font-semibold text-gray-700">Multiple locations across India</p>
            <p class="text-xs text-gray-500 mt-2">Book an appointment</p>
        </div>

        <div class="contact-block">
            <div class="icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-2">Live Chat</h3>
            <p class="text-sm font-semibold text-gray-700">Available 24/7</p>
            <p class="text-xs text-gray-500 mt-2">Instant assistance</p>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
        <!-- FAQ Section -->
        <div class="flex-1">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
            <div class="faq-accordion" id="faqAccordion">
                <div class="faq-item">
                    <div class="faq-header" onclick="toggleFaq(this)">
                        What is your return policy?
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <div class="faq-content">
                        We offer a 7-day hassle-free return policy for all unpacked/unused items. For defective
                        products, we process returns within 14 days of delivery.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-header" onclick="toggleFaq(this)">
                        Do you offer international shipping?
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <div class="faq-content">
                        Currently, Zound operates exclusively within India. We plan to expand to international
                        deliveries in the coming year.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-header" onclick="toggleFaq(this)">
                        How long is the warranty period?
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <div class="faq-content">
                        Every brand provides its own manufacturing warranty (typically 1-2 years). You can claim
                        warranty via the respective brand's service centers.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-header" onclick="toggleFaq(this)">
                        What payment methods do you accept?
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <div class="faq-content">
                        We accept all major Credit/Debit Cards, UPI, Net Banking via Razorpay. We also offer Cash on
                        Delivery (COD) for supported pincodes.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-header" onclick="toggleFaq(this)">
                        How do I track my order?
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </div>
                    <div class="faq-content">
                        Once your order ships, you will receive a tracking link via SMS and email. You can also view
                        it in your Profile > Orders tab.
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form Section -->
        <div class="lg:w-1/3">
            <div class="bg-white border rounded-lg shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-6">Send us a message</h2>
                <form id="contactForm" onsubmit="handleContactSubmit(event)">
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Full Name *</label>
                        <input type="text" id="contactName"
                            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-yellow-500"
                            placeholder="John Doe">
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Email Address *</label>
                        <input type="email" id="contactEmail"
                            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-yellow-500"
                            placeholder="john@example.com">
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Subject *</label>
                        <select id="contactSubject"
                            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-yellow-500 bg-white">
                            <option value="">Select a subject</option>
                            <option value="order">Order Query</option>
                            <option value="product">Product Information</option>
                            <option value="return">Returns / Refunds</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Message *</label>
                        <textarea id="contactMessage" rows="4"
                            class="w-full border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-yellow-500"
                            placeholder="How can we help you?"></textarea>
                    </div>
                    <button type="submit"
                        class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-3 rounded-md transition-colors text-sm shadow-sm">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Bottom Resources -->
    <div class="mt-20">
        <h2 class="text-xl font-bold text-gray-900 mb-6 text-center">Additional Resources</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="resource-card">
                <h3 class="font-bold text-gray-900 mb-2">Product Guides</h3>
                <p class="text-sm text-gray-500 mb-4 line-clamp-2">Detailed user guides and manuals for our top
                    audio products.</p>
                <a href="#"
                    class="text-yellow-600 font-bold text-sm hover:text-yellow-700 flex items-center justify-center gap-1">Browse
                    Guides <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg></a>
            </div>
            <div class="resource-card">
                <h3 class="font-bold text-gray-900 mb-2">Video Tutorials</h3>
                <p class="text-sm text-gray-500 mb-4 line-clamp-2">Step-by-step video tutorials on building desktops
                    and audio setups.</p>
                <a href="#"
                    class="text-yellow-600 font-bold text-sm hover:text-yellow-700 flex items-center justify-center gap-1">Watch
                    Videos <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg></a>
            </div>
            <div class="resource-card">
                <h3 class="font-bold text-gray-900 mb-2">Community Forum</h3>
                <p class="text-sm text-gray-500 mb-4 line-clamp-2">Connect with other audio enthusiasts and experts.
                </p>
                <a href="#"
                    class="text-yellow-600 font-bold text-sm hover:text-yellow-700 flex items-center justify-center gap-1">Join
                    Forum <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg></a>
            </div>
        </div>
    </div>

</main>

<script src="/js/user/support.js"></script>