
<div class="flex justify-center items-center min-h-screen bg-gray-50">
  <div class="bg-white rounded-xl shadow-md p-10 w-full max-w-md">

    <!-- Title -->
    <h1 class="text-2xl font-bold text-center mb-3" style="color:#002366;">
      Forgot Your Password?
    </h1>

    <p class="text-center text-gray-600 mb-6">
      Enter your email address to receive a one-time password to reset your account password.
    </p>

    <% if (typeof message !== 'undefined') { %>
      <p class="text-red-500 text-center mb-3"><%= message %></p>
    <% } %>

    <!-- Form -->
    <form action="/user/forgot-password" method="POST">

      <label class="text-gray-700 font-medium">Email Address</label>

      <input 
        type="email" 
        name="email"
        class="w-full border border-gray-300 p-3 rounded-lg mt-1 mb-4 bg-gray-100 focus:ring-2 focus:ring-[#002366] focus:border-[#002366]"
        placeholder="Enter your email address"
        required
      />

      <button 
        class="w-full text-white p-3 rounded-lg font-semibold mt-2 hover:opacity-90"
        style="background-color:#002366;">
        Send OTP
      </button>
    </form>

    <!-- Back to Login -->
    <p class="text-center text-sm mt-4">
      <span class="text-gray-600">Remember your password?</span>
      <a href="/user/login" class="font-semibold hover:underline ml-1" style="color:#002366;">
        Back to Login
      </a>
    </p>

  </div>
</div>

