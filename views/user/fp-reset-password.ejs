<link rel="stylesheet" href="/styles/user/fp-reset-password.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

<div class="flex justify-center items-center min-h-screen bg-gray-50">
    <div class="bg-white p-10 rounded-xl shadow-md w-full max-w-md">

        <!-- Title -->
        <h1 class="text-2xl font-bold text-center mb-3" style="color:#002366;">
            Reset Your Password
        </h1>

        <p class="text-center text-gray-600 mb-6">
            Create a new strong password (min 8 characters).
        </p>

        <% if (message) { %>
            <p class="text-red-500 text-center mb-3">
                <%= message %>
            </p>
            <% } %>

                <!-- FORM START -->
                <form action="/user/fp-reset-password" method="POST" id="resetForm">

                    <!-- NEW PASSWORD -->
                    <label class="font-medium text-gray-700">New Password</label>
                    <div class="password-box mb-4">
                        <input id="password" type="password" name="password" placeholder="Enter new password" class="w-full border border-gray-300 bg-gray-100 p-3 rounded-lg 
                    focus:ring-2 focus:ring-[#002366] focus:border-[#002366]" required />
                        <span id="togglePass" class="material-symbols-outlined eye-icon">visibility</span>
                    </div>
                    <div id="error1" class="error-message"></div>

                    <!-- CONFIRM PASSWORD -->
                    <label class="font-medium text-gray-700">Confirm Password</label>
                    <div class="password-box mb-4">
                        <input id="confirmPassword" type="password" name="confirmPassword"
                            placeholder="Confirm new password" class="w-full border border-gray-300 bg-gray-100 p-3 rounded-lg 
                    focus:ring-2 focus:ring-[#002366] focus:border-[#002366]" required />
                        <span id="togglePass2" class="material-symbols-outlined eye-icon">visibility</span>
                    </div>
                    <div id="error2" class="error-message"></div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="w-full text-white p-3 rounded-lg font-semibold"
                        style="background-color:#002366;">
                        Reset Password
                    </button>

                </form>
                <!-- FORM END -->

    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- PASSWORD VISIBILITY + VALIDATION -->
<script>
    function debounce(func, delay) {
        let timer;
        return function () {
            clearTimeout(timer);
            timer = setTimeout(func, delay);
        };
    }


    // TOGGLE VISIBILITY
    function attachToggle(btnId, inputId) {
        const btn = document.getElementById(btnId);
        const field = document.getElementById(inputId);

        btn.addEventListener("click", () => {
            const hidden = field.type === "password";
            field.type = hidden ? "text" : "password";
            btn.textContent = hidden ? "visibility_off" : "visibility";
        });
    }

    attachToggle("togglePass", "password");
    attachToggle("togglePass2", "confirmPassword");


    // FRONTEND PASSWORD VALIDATION

    const pass = document.getElementById("password");
    const confirm = document.getElementById("confirmPassword");

    const error1 = document.getElementById("error1");
    const error2 = document.getElementById("error2");

    function validatePasswordFields() {
        const p = pass.value.trim();
        const c = confirm.value.trim();
        const alpha = /[A-Za-z]/;
        const digit = /\d/;

        // NEW PASSWORD VALIDATION
        if (p === "") {
            error1.textContent = "Please enter a password.";
        } else if (p.length < 8) {
            error1.textContent = "Password must be at least 8 characters long.";
        } else if (!alpha.test(p) || !digit.test(p)) {
            error1.textContent = "Password must contain at least one letter and one number.";
        } else {
            error1.textContent = "";
        }

        // CONFIRM PASSWORD 
        
        if (c === "") {
            error2.textContent = "Please confirm your password.";
        } else if (p !== c) {
            error2.textContent = "Passwords do not match.";
        } else {
            error2.textContent = "";
        }
    }

    // Validate on input
    pass.addEventListener("input", debounce(validatePasswordFields, 500));
    confirm.addEventListener("input", debounce(validatePasswordFields, 500));

    // AJAX Submit
    const form = document.getElementById("resetForm");

    form.addEventListener('submit', async function (e) {
        e.preventDefault();

        validatePasswordFields();

        if (error1.textContent !== "" || error2.textContent !== "") {
            return; // stop submitting
        }

        const payload = {
            password: pass.value.trim(),
            confirmPassword: confirm.value.trim()
        };

        const res = await fetch('/user/fp-reset-password', {
            method: 'POST',
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (data.success) {
            Swal.fire({
                icon: "success",
                title: "Password Reset Successful!",
                text: data.message,
                confirmButtonColor: "#002366"
            }).then(() => {
                window.location.href = '/user/login';
            });
        } else {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: data.message,
                confirmButtonColor: "#d33"
            });
        }
    });

</script>