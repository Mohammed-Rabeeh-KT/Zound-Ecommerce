<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

<div class="min-h-screen flex items-center justify-center px-4 bg-gray-50">

  <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">

    <!-- Title -->
    <h1 class="text-2xl font-bold text-center mb-3" style="color:#002366;">
      Verify OTP
    </h1>

    <p class="text-gray-600 text-center mb-6">
      Please enter the 6-digit verification code sent to your email address.
    </p>

    <!-- OTP FORM -->
    <form id="otpForm">

      <div class="flex justify-between mb-6">
        <% for (let i=0; i < 6; i++) { %>
          <input type="text" maxlength="1" name="otp[]" class="otp-input w-12 h-14 text-center border border-gray-300 bg-gray-100 rounded-lg focus:ring-2 focus:ring-[#002366] focus:border-[#002366] text-lg" />
          <% } %>
      </div>

      <!-- Verify Button -->
      <button type="submit" class="w-full text-white font-semibold py-3 rounded-lg" style="background-color:#002366;">
        Verify OTP
      </button>
    </form>

    <!-- Timer -->
    <p class="text-center text-gray-600 text-sm mt-4">
      OTP will expire in <span id="otp-timer">02:00</span>
    </p>

    <!-- Resend OTP -->
    <p class="text-center text-sm mt-4">
      Didn’t receive the code?
      <a id="resendBtn" class="font-semibold cursor-pointer text-[#002366]">
        Resend OTP
      </a>
    </p>

    <!-- Back to Login -->
    <p class="text-center text-sm mt-4">
      <span class="text-gray-600">Remember your password?</span>
      <a href="/user/login" class="font-semibold hover:underline ml-1" style="color:#002366;">
        Back to Login
      </a>
    </p>

  </div>
</div>

<script src="/js/user/fpVerifyOtp.js"></script>