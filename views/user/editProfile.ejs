<link rel="stylesheet" href="/styles/user/editProfile.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">

<div class="page-container">

    <%- include('../partials/user/user-sidebar', { currentPage: 'edit-profile' }) %>

        <main class="main-content">

            <header class="page-header">
                <h1 class="headline">Edit Profile</h1>
                <p class="sub-headline">Update your personal account details.</p>
            </header>

            <section class="premium-card">

                <div class="card-banner">
                    <div class="banner-gradient"></div>
                    <div class="user-meta">
                        <div class="avatar-container" onclick="openImageUploadModal()">
                            <div class="avatar-ring" id="avatarRing">
                                <% if (user.profile_picture) { %>
                                    <img src="<%= user.profile_picture %>" alt="Profile" class="avatar-image"
                                        id="avatarImage">
                                    <% } else { %>
                                        <div class="avatar-placeholder" id="avatarPlaceholder">
                                            <%= user.name.charAt(0).toUpperCase() %>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="avatar-overlay">
                                <svg class="camera-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z">
                                    </path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                                <span class="overlay-text">Change Photo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Profile Picture Upload Modal -->
                <div class="upload-modal" id="uploadModal">
                    <div class="upload-modal-backdrop" onclick="closeImageUploadModal()"></div>
                    <div class="upload-modal-content">
                        <div class="upload-modal-header">
                            <h3 class="upload-modal-title">Update Profile Picture</h3>
                            <button type="button" class="upload-modal-close" onclick="closeImageUploadModal()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>

                        <div class="upload-modal-body">
                            <!-- Upload Zone (shown when no image selected) -->
                            <div class="upload-zone" id="uploadZone">
                                <div class="upload-zone-content">
                                    <svg class="upload-zone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="17 8 12 3 7 8"></polyline>
                                        <line x1="12" y1="3" x2="12" y2="15"></line>
                                    </svg>
                                    <p class="upload-zone-text">Drag and drop your image here</p>
                                    <p class="upload-zone-subtext">or</p>
                                    <label class="upload-browse-btn">
                                        Browse Files
                                        <input type="file" id="profileImageInput" accept="image/*"
                                            onchange="handleImageSelect(event)" hidden>
                                    </label>
                                    <p class="upload-zone-hint">Supports: JPG, PNG, GIF (Max 5MB)</p>
                                </div>
                            </div>

                            <!-- Cropper Zone (shown when image is selected) -->
                            <div class="cropper-zone" id="cropperZone" style="display: none;">
                                <div class="cropper-container">
                                    <img id="cropperImage" src="" alt="Crop preview">
                                </div>
                            </div>
                        </div>

                        <div class="upload-modal-footer">
                            <button type="button" class="btn btn-outline" onclick="cancelCrop()" id="cancelCropBtn"
                                style="display: none;">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-primary" onclick="saveCroppedImage()" id="saveCropBtn"
                                style="display: none;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Save Photo
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="card-title-row">
                        <h2 class="section-title">Update Details</h2>
                    </div>

                    <form id="editProfileForm" onsubmit="handleProfileUpdate(event)">
                        <div class="form-grid">

                            <div class="form-group-card">
                                <label class="form-label">
                                    <svg class="form-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Full Name
                                </label>
                                <input type="text" name="name" id="name" class="form-input" value="<%= user.name %>"
                                    required>
                            </div>

                            <div class="form-group-card">
                                <label class="form-label">
                                    <svg class="form-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path
                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                        </path>
                                    </svg>
                                    Phone Number
                                </label>
                                <input type="tel" name="phone" id="phone" class="form-input"
                                    value="<%= user.phone || '' %>" placeholder="+91">
                            </div>

                            <div class="form-group-card full-width" id="email-group-container">
                                <label class="form-label">
                                    <svg class="form-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path
                                            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                                        </path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                    Email Address
                                    <% if (user.googleId) { %>
                                        <span class="google-badge">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                                <path
                                                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                                                    fill="#4285F4" />
                                                <path
                                                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                                                    fill="#34A853" />
                                                <path
                                                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                                                    fill="#FBBC05" />
                                                <path
                                                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                                                    fill="#EA4335" />
                                            </svg>
                                            Google Account
                                        </span>
                                        <% } %>
                                </label>

                                <div class="input-wrapper">
                                    <input type="email" name="email" id="email" class="form-input"
                                        value="<%= user.email %>" required <% if (user.googleId) { %>readonly
                                    class="form-input readonly"<% } %>>

                                        <% if (!user.googleId) { %>
                                            <button type="button" id="btn-trigger-verify" class="verify-pill-btn"
                                                onclick="initiateEmailVerification()" style="display: none;">
                                                Verify
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2.5">
                                                    <path d="M22 2L11 13"></path>
                                                    <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
                                                </svg>
                                            </button>

                                            <div id="verified-badge" class="verified-badge" style="display: none;">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="3">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                Verified
                                            </div>
                                            <% } %>
                                </div>

                                <% if (user.googleId) { %>
                                    <p class="google-info-text">Email cannot be changed for Google-linked accounts.</p>
                                    <% } %>

                                        <p id="email-feedback" class="feedback-text"></p>

                                        <% if (!user.googleId) { %>
                                            <div id="inline-otp-section" class="otp-dropdown">
                                                <div class="otp-content">
                                                    <p class="otp-instruction">
                                                        <i class="bi bi-shield-lock"></i> Enter the 6-digit code sent to
                                                        your new
                                                        email.
                                                    </p>
                                                    <div class="otp-action-row">
                                                        <input type="text" id="inlineOtpInput" class="otp-small-input"
                                                            placeholder="000000" maxlength="6">
                                                        <button type="button" class="btn-verify-small"
                                                            onclick="verifyInlineOtp()">
                                                            Verify & Apply
                                                        </button>
                                                    </div>
                                                    <div id="inline-otp-error" class="error-text"></div>
                                                    <div id="inline-timer" class="timer-text"></div>
                                                </div>
                                            </div>
                                            <% } %>

                                                <input type="hidden" id="originalEmail" value="<%= user.email %>">
                                                <input type="hidden" id="originalName" value="<%= user.name %>">
                                                <input type="hidden" id="originalPhone" value="<%= user.phone || '' %>">
                                                <input type="hidden" id="isGoogleUser"
                                                    value="<%= user.googleId ? 'true' : 'false' %>">
                            </div>


                            <!-- Change Password Section (Hidden for Google OAuth users) -->
                            <% if (!user.googleId) { %>
                                <div class="form-group-card full-width" id="password-section-container">
                                    <div class="password-trigger" onclick="togglePasswordSection()">
                                        <div class="trigger-left">
                                            <svg class="form-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                            </svg>
                                            <span class="trigger-text">Change Password</span>
                                        </div>
                                        <svg class="chevron-icon" id="password-chevron" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </div>

                                    <div id="password-dropdown" class="password-dropdown">
                                        <div class="password-content">
                                            <p class="password-instruction">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                                </svg>
                                                Enter your current password and choose a new secure password.
                                            </p>

                                            <div class="password-fields">
                                                <div class="password-field-group">
                                                    <label class="password-field-label">Current Password</label>
                                                    <div class="password-input-wrapper">
                                                        <input type="password" id="currentPassword"
                                                            class="password-input" placeholder="Enter current password">
                                                        <button type="button" class="toggle-password"
                                                            onclick="togglePasswordVisibility('currentPassword', this)">
                                                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                </path>
                                                                <circle cx="12" cy="12" r="3"></circle>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                    <div id="currentPassword-error" class="field-error"></div>
                                                </div>

                                                <div class="password-field-group">
                                                    <label class="password-field-label">New Password</label>
                                                    <div class="password-input-wrapper">
                                                        <input type="password" id="newPassword" class="password-input"
                                                            placeholder="Enter new password"
                                                            oninput="validateNewPassword()">
                                                        <button type="button" class="toggle-password"
                                                            onclick="togglePasswordVisibility('newPassword', this)">
                                                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                </path>
                                                                <circle cx="12" cy="12" r="3"></circle>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                    <div id="newPassword-error" class="field-error"></div>
                                                    <div class="password-requirements">
                                                        <span class="req" id="req-length">✗ At least 8 characters</span>
                                                        <span class="req" id="req-upper">✗ One uppercase letter</span>
                                                        <span class="req" id="req-lower">✗ One lowercase letter</span>
                                                        <span class="req" id="req-number">✗ One number</span>
                                                    </div>
                                                </div>

                                                <div class="password-field-group">
                                                    <label class="password-field-label">Confirm New Password</label>
                                                    <div class="password-input-wrapper">
                                                        <input type="password" id="confirmPassword"
                                                            class="password-input" placeholder="Confirm new password"
                                                            oninput="validateConfirmPassword()">
                                                        <button type="button" class="toggle-password"
                                                            onclick="togglePasswordVisibility('confirmPassword', this)">
                                                            <svg class="eye-icon" viewBox="0 0 24 24" fill="none"
                                                                stroke="currentColor" stroke-width="2">
                                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z">
                                                                </path>
                                                                <circle cx="12" cy="12" r="3"></circle>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                    <div id="confirmPassword-error" class="field-error"></div>
                                                </div>
                                            </div>

                                            <div id="password-feedback" class="password-feedback"></div>

                                            <div class="password-action-row">
                                                <button type="button" class="btn-change-password" id="changePasswordBtn"
                                                    onclick="handleChangePassword()">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <polyline points="20 6 9 17 4 12"></polyline>
                                                    </svg>
                                                    Update Password
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                        </div>

                        <div class="form-actions">
                            <a href="/user/profile" class="btn btn-outline">Cancel</a>
                            <button type="submit" class="btn btn-primary" id="saveBtn" disabled>
                                <i class="bi bi-check2-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </section>

        </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script src="/js/user/editProfile.js"></script>