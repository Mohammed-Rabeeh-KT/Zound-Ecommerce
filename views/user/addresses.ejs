<link rel="stylesheet" href="/styles/user/addresses.css">

<div class="page-container">

    <%- include('../partials/user/user-sidebar', { currentPage: 'addresses' }) %>

        <main class="main-content">

            <header class="page-header">
                <div class="header-row">
                    <div class="header-text">
                        <h1 class="headline">My Addresses</h1>
                        <p class="sub-headline">Manage your delivery addresses</p>
                    </div>
                    <button type="button" class="btn-add-address" id="addAddressBtn" onclick="toggleAddressForm()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Address
                    </button>
                </div>
            </header>

            <!-- Add Address Dropdown Form -->
            <div class="address-form-dropdown" id="addressFormDropdown">
                <div class="form-card">
                    <div class="form-header">
                        <h3 class="form-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            Add New Address
                        </h3>
                        <button type="button" class="btn-close-form" onclick="toggleAddressForm()">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    <form id="addAddressForm" onsubmit="handleAddAddress(event)">
                        <div class="form-grid">

                            <!-- Address Label -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path
                                            d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z">
                                        </path>
                                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                    </svg>
                                    Address Label <span class="required">*</span>
                                </label>
                                <select name="label" id="addressLabel" class="form-input" required>
                                    <option value="">Select Label</option>
                                    <option value="Home">Home</option>
                                    <option value="Work">Work</option>
                                    <option value="Other">Other</option>
                                </select>
                                <div class="field-error" id="labelError"></div>
                            </div>

                            <!-- Full Name -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Full Name <span class="required">*</span>
                                </label>
                                <input type="text" name="fullName" id="fullName" class="form-input"
                                    placeholder="Enter full name" required>
                                <div class="field-error" id="fullNameError"></div>
                            </div>

                            <!-- Address Line 1 -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                    Address Line 1 <span class="required">*</span>
                                </label>
                                <input type="text" name="addressLine1" id="addressLine1" class="form-input"
                                    placeholder="House No, Building, Street" required>
                                <div class="field-error" id="addressLine1Error"></div>
                            </div>

                            <!-- Address Line 2 -->
                            <div class="form-group full-width">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    </svg>
                                    Address Line 2
                                </label>
                                <input type="text" name="addressLine2" id="addressLine2" class="form-input"
                                    placeholder="Apartment, Landmark (Optional)">
                            </div>

                            <!-- Phone Number -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path
                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                        </path>
                                    </svg>
                                    Phone Number <span class="required">*</span>
                                </label>
                                <input type="tel" name="phone" id="phone" class="form-input"
                                    placeholder="+91 XXXXX XXXXX" required>
                                <div class="field-error" id="phoneError"></div>
                            </div>

                            <!-- Alternative Phone -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path
                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                        </path>
                                    </svg>
                                    Alternative Phone
                                </label>
                                <input type="tel" name="altPhone" id="altPhone" class="form-input"
                                    placeholder="+91 XXXXX XXXXX (Optional)">
                            </div>

                            <!-- City -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="10" r="3"></circle>
                                        <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z">
                                        </path>
                                    </svg>
                                    City <span class="required">*</span>
                                </label>
                                <input type="text" name="city" id="city" class="form-input" placeholder="Enter city"
                                    required>
                                <div class="field-error" id="cityError"></div>
                            </div>

                            <!-- State -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    State <span class="required">*</span>
                                </label>
                                <input type="text" name="state" id="state" class="form-input" placeholder="Enter state"
                                    required>
                                <div class="field-error" id="stateError"></div>
                            </div>

                            <!-- Pincode -->
                            <div class="form-group">
                                <label class="form-label">
                                    <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                    </svg>
                                    Pincode <span class="required">*</span>
                                </label>
                                <input type="text" name="pincode" id="pincode" class="form-input"
                                    placeholder="6-digit pincode" maxlength="6" required>
                                <div class="field-error" id="pincodeError"></div>
                            </div>

                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <button type="button" class="btn btn-outline" onclick="toggleAddressForm()">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="saveAddressBtn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                Save Address
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Address List Section -->
            <section class="addresses-section">
                <% if (addresses && addresses.length> 0) { %>
                    <div class="addresses-grid">
                        <% addresses.forEach((address, index)=> { %>
                            <div class="address-card <%= address.isDefault ? 'default' : '' %>"
                                data-id="<%= address._id %>">
                                <div class="address-header">
                                    <span class="address-label">
                                        <% if (address.label==='Home' ) { %>
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                            </svg>
                                            <% } else if (address.label==='Work' ) { %>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                                </svg>
                                                <% } else { %>
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                        <circle cx="12" cy="10" r="3"></circle>
                                                    </svg>
                                                    <% } %>
                                                        <%= address.label %>
                                    </span>
                                    <% if (address.isDefault) { %>
                                        <span class="default-badge">Default</span>
                                        <% } %>
                                </div>

                                <div class="address-body">
                                    <p class="address-name">
                                        <%= address.fullName %>
                                    </p>
                                    <p class="address-text">
                                        <%= address.addressLine1 %>
                                    </p>
                                    <% if (address.addressLine2) { %>
                                        <p class="address-text">
                                            <%= address.addressLine2 %>
                                        </p>
                                        <% } %>
                                            <p class="address-text">
                                                <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                                            </p>
                                            <p class="address-phone">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                                    </path>
                                                </svg>
                                                <%= address.phone %>
                                            </p>
                                            <% if (address.altPhone) { %>
                                                <p class="address-phone alt-phone">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <path
                                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                                        </path>
                                                    </svg>
                                                    <%= address.altPhone %> <span class="alt-label">(Alt)</span>
                                                </p>
                                                <% } %>
                                </div>

                                <div class="address-actions">
                                    <% if (!address.isDefault) { %>
                                        <button type="button" class="action-btn set-default"
                                            onclick="setDefaultAddress('<%= address._id %>')" title="Set as Default">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </button>
                                        <% } %>
                                            <button type="button" class="action-btn edit"
                                                onclick="editAddress('<%= address._id %>')" title="Edit">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path
                                                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                    </path>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                    </path>
                                                </svg>
                                            </button>
                                            <button type="button" class="action-btn delete"
                                                onclick="deleteAddress('<%= address._id %>')" title="Delete">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path
                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                    </path>
                                                </svg>
                                            </button>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="1.5">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <h3>No Addresses Yet</h3>
                            <p>Add your first delivery address to get started</p>
                            <button type="button" class="btn btn-primary" onclick="toggleAddressForm()">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Add Your First Address
                            </button>
                        </div>
                        <% } %>
            </section>

        </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/user/addresses.js"></script>