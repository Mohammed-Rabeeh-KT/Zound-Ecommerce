<link rel="stylesheet" href="/styles/user/addresses.css">

<div class="page-container">

    <%- include('../partials/user/user-sidebar', { currentPage: 'addresses' }) %>

        <main class="main-content">

            <header class="page-header">
                <div class="header-row">
                    <div class="header-text">
                        <h1 class="headline">My Addresses</h1>
                        <p class="sub-headline">Manage your delivery addresses</p>
                    </div>
                    <button type="button" class="btn-add-address" id="addAddressBtn" onclick="toggleAddressForm()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Address
                    </button>
                </div>
            </header>

            <!-- Add Address Dropdown Form (Partial) -->
            <%- include('../partials/user/address-form') %>

                <!-- Address List Section -->
                <section class="addresses-section">
                    <% if (addresses && addresses.length> 0) { %>
                        <div class="addresses-grid">
                            <% addresses.forEach((address, index)=> { %>
                                <div class="address-card <%= address.isDefault ? 'default' : '' %>"
                                    data-id="<%= address._id %>">
                                    <div class="address-header">
                                        <span class="address-label">
                                            <% if (address.label==='Home' ) { %>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                                </svg>
                                                <% } else if (address.label==='Work' ) { %>
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                                    </svg>
                                                    <% } else { %>
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z">
                                                            </path>
                                                            <circle cx="12" cy="10" r="3"></circle>
                                                        </svg>
                                                        <% } %>
                                                            <%= address.label %>
                                        </span>
                                        <% if (address.isDefault) { %>
                                            <span class="default-badge">Default</span>
                                            <% } %>
                                    </div>

                                    <div class="address-body">
                                        <p class="address-name">
                                            <%= address.fullName %>
                                        </p>
                                        <p class="address-text">
                                            <%= address.addressLine1 %>
                                        </p>
                                        <% if (address.addressLine2) { %>
                                            <p class="address-text">
                                                <%= address.addressLine2 %>
                                            </p>
                                            <% } %>
                                                <p class="address-text">
                                                    <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                                                </p>
                                                <p class="address-phone">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <path
                                                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                                        </path>
                                                    </svg>
                                                    <%= address.phone %>
                                                </p>
                                                <% if (address.altPhone) { %>
                                                    <p class="address-phone alt-phone">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <path
                                                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                                            </path>
                                                        </svg>
                                                        <%= address.altPhone %> <span class="alt-label">(Alt)</span>
                                                    </p>
                                                    <% } %>
                                    </div>

                                    <div class="address-actions">
                                        <% if (!address.isDefault) { %>
                                            <button type="button" class="action-btn set-default"
                                                onclick="setDefaultAddress('<%= address._id %>')"
                                                title="Set as Default">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                            </button>
                                            <% } %>
                                                <button type="button" class="action-btn edit"
                                                    onclick="editAddress('<%= address._id %>')" title="Edit">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2">
                                                        <path
                                                            d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                                        </path>
                                                        <path
                                                            d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                                        </path>
                                                    </svg>
                                                </button>
                                                <% if (!address.isDefault) { %>
                                                    <button type="button" class="action-btn delete"
                                                        onclick="deleteAddress('<%= address._id %>')" title="Delete">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                            stroke="currentColor" stroke-width="2">
                                                            <polyline points="3 6 5 6 21 6"></polyline>
                                                            <path
                                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                            </path>
                                                        </svg>
                                                    </button>
                                                    <% } %>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <div class="empty-state">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1.5">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <h3>No Addresses Yet</h3>
                                <p>Add your first delivery address to get started</p>
                                <button type="button" class="btn btn-primary" onclick="toggleAddressForm()">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    Add Your First Address
                                </button>
                            </div>
                            <% } %>
                </section>

        </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/user/addresses.js"></script>