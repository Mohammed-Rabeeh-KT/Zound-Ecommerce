<link rel="stylesheet" href="/styles/user/brands.css">

<div class="hero-banner">
    <div class="max-w-4xl mx-auto">
        <h1>Our Curated Brands</h1>
        <p>We partner with the world's most respected audio manufacturers to bring you exceptional sound quality and
            craftsmanship</p>
    </div>
</div>

<main class="max-w-7xl mx-auto px-4 py-12">

    <% if (featuredBrands && featuredBrands.length> 0) { %>
        <section class="mb-16">
            <h2 class="text-xl font-bold mb-6 text-neutral-800">Featured Brands</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                <% featuredBrands.forEach(brand=> { %>
                    <div class="brand-card">
                        <div class="brand-logo-container">
                            <% if (brand.logo) { %>
                                <img src="<%= brand.logo %>" alt="<%= brand.brandName %>" class="brand-logo-img">
                                <% } else { %>
                                    <span class="brand-logo-text">
                                        <%= brand.brandName.substring(0, 2).toUpperCase() %>
                                    </span>
                                    <% } %>
                        </div>
                        <div class="px-6 flex-1 text-center">
                            <h3 class="text-lg font-bold text-gray-900 mb-2">
                                <%= brand.brandName %>
                            </h3>
                            <p class="text-xs text-gray-500 line-clamp-2 mb-6">
                                <%= brand.description
                                    || "Premium quality audio products designed for the modern audiophile." %>
                            </p>
                        </div>

                        <div class="px-6 pb-6 flex justify-between items-center text-sm">
                            <span class="text-gray-500 font-medium">
                                <%= brand.productCount %> Products
                            </span>
                            <a href="/user/products?brand=<%= brand._id %>"
                                class="text-yellow-600 font-semibold hover:text-yellow-700 flex items-center gap-1">
                                View All
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                        <div class="featured-badge">Featured Brand</div>
                    </div>
                    <% }) %>
            </div>
        </section>
        <% } %>

            <section class="mb-16">
                <h2 class="text-xl font-bold mb-6 text-neutral-800">All Brands</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <% allBrands.forEach(brand=> { %>
                        <div class="brand-card">
                            <div class="brand-logo-container">
                                <% if (brand.logo) { %>
                                    <img src="<%= brand.logo %>" alt="<%= brand.brandName %>" class="brand-logo-img">
                                    <% } else { %>
                                        <span class="brand-logo-text">
                                            <%= brand.brandName.substring(0, 2).toUpperCase() %>
                                        </span>
                                        <% } %>
                            </div>
                            <div class="px-6 flex-1 text-center">
                                <h3 class="text-lg font-bold text-gray-900 mx-auto w-max mb-2">
                                    <%= brand.brandName %>
                                </h3>
                                <p class="text-xs text-gray-500 line-clamp-2 mb-6">
                                    <%= brand.description || "Explore incredible sound technologies and designs." %>
                                </p>
                            </div>
                            <div class="px-6 pb-6 flex justify-between items-center text-sm">
                                <span class="text-gray-500 font-medium">
                                    <%= brand.productCount %> Products
                                </span>
                                <a href="/user/products?brand=<%= brand._id %>"
                                    class="text-yellow-600 font-semibold hover:text-yellow-700 flex items-center gap-1">
                                    View All
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M5 12h14M12 5l7 7-7 7" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </section>

            <!-- CTA Section -->
            <section class="text-center py-12 px-4 max-w-2xl mx-auto">
                <h3 class="text-xl font-bold mb-3">Can't find your favorite brand?</h3>
                <p class="text-gray-500 text-sm mb-6">We're constantly expanding our collection. Let us know which
                    brands you'd like to see in our store.</p>
                <a href="/user/support"
                    class="inline-block bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-3 px-8 rounded-full transition-colors text-sm">
                    Request a Brand
                </a>
            </section>

</main>