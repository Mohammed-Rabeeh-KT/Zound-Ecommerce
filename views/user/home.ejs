<link rel="stylesheet" href="/styles/user/home.css" />

<div class="magnified-container pb-20 space-y-16 font-inter">

  <!-- HERO -->
  <section class="mt-8">
    <div class="relative bg-black text-white rounded-[32px] overflow-hidden
                min-h-[400px] md:min-h-[500px] flex flex-col md:flex-row items-center
                px-10 md:px-16 py-12 gap-10">

      <div class="max-w-2xl space-y-6 z-10">
        <p class="text-xs tracking-[0.3em] uppercase text-neutral-400 font-bold">
          Premium Audio Collection
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight">
          Experience Sound,<br class="hidden md:block" /> Redefined.
        </h1>
        <p class="text-base md:text-lg text-neutral-300 max-w-lg leading-relaxed">
          Discover curated headphones, speakers and IEMs crafted for the true audiophile.
        </p>
        <a href="/user/products" class="inline-block">
        <button class="mt-4 inline-flex items-center px-8 py-4 rounded-full 
                       bg-yellow-500 text-black text-sm md:text-base font-bold hover:bg-yellow-400 transition-colors">
          Explore Collection
          <span class="material-icons text-[18px] ml-2">arrow_forward</span>
        </button>
        </a>
      </div>

      <!-- Placeholder for Hero Image if needed -->
      <div class="absolute right-0 top-0 h-full w-1/2 bg-gradient-to-l from-neutral-800 to-transparent opacity-50">
      </div>

      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-white cursor-pointer"></span>
        <span
          class="w-2.5 h-2.5 rounded-full bg-neutral-600 hover:bg-neutral-500 cursor-pointer transition-colors"></span>
        <span
          class="w-2.5 h-2.5 rounded-full bg-neutral-600 hover:bg-neutral-500 cursor-pointer transition-colors"></span>
      </div>
    </div>
  </section>

  <!-- SHOP BY CATEGORY -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="font-extrabold text-3xl md:text-4xl tracking-tight">Shop by Category</h2>
      <a href="/user/products" class="text-sm font-medium text-neutral-500 hover:text-black transition-colors">View
        All</a>
    </div>


    <!-- Top 5 Categories Grid -->
    <div class="grid grid-cols-5 gap-6">
      <% if (categories && categories.length> 0) { %>
        <% const topCats=categories.slice(0, 5); %>
          <% topCats.forEach(cat=> { %>
            <a href="/user/products?category=<%=cat.slug %>"
              class="block group relative rounded-2xl overflow-hidden bg-neutral-100 cat-card-lg">
              <img src="<%= cat.image %>"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                alt="<%= cat.name %>">
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
                <p class="text-white font-semibold text-lg text-center">
                  <%= cat.name %>
                </p>
              </div>
            </a>
            <% }) %>
              <% } %>
    </div>
  </section>

  <!-- LATEST DROPS (NEW) -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="font-extrabold text-3xl md:text-4xl tracking-tight">Latest Drops</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <% if (latestProducts && latestProducts.length> 0) { %>
        <% latestProducts.forEach(p=> { %>
          <%- include('../partials/user/product-card', { product: p }) %>
            <% }) %>
              <% } else { %>
                <p class="col-span-full text-center text-neutral-500">No new arrivals yet.</p>
                <% } %>
    </div>
  </section>


  <!-- SEASONAL SALE -->
  <section>
    <div class="bg-gradient-to-r from-blue-100 to-blue-200 rounded-3xl
                flex flex-col md:flex-row items-center p-6 md:p-10 gap-6">

      <div class="flex-1 flex flex-col md:flex-row items-center gap-6">
        <div>
          <p class="text-sm font-semibold text-brandBlue">20% OFF</p>
          <p class="text-xs text-neutral-600">On select products</p>
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-lg text-brandDark">
            Seasonal weekly sale 2025
          </h3>
          <p class="text-xs text-neutral-700">
            Use code
            <span class="font-semibold bg-white/70 px-2 py-0.5 rounded-full
                         border text-[11px] uppercase">
              SALE2025
            </span>
            to get the best offer.
          </p>
        </div>
      </div>

      <img src="/images/banners/sale-headphones.png" class="w-40 md:w-48 object-contain" />
    </div>
  </section>

  <!-- SERVICE ICON ROW -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
    <%- include('../partials/user/service-icons') %>
  </section>

  <!-- TOP SELLING (DB) -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="font-extrabold text-3xl md:text-4xl tracking-tight">Top Selling Products</h2>
      <!-- Optional Filter Tabs
      <div class="hidden md:flex gap-6 text-sm font-medium text-neutral-500">
        <span class="text-black border-b-2 border-black pb-1 cursor-pointer">All</span>
        <span class="hover:text-black cursor-pointer transition-colors">Headphones</span>
        <span class="hover:text-black cursor-pointer transition-colors">IEMs</span>
      </div> -->
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <% if (topProducts && topProducts.length> 0) { %>
        <% topProducts.forEach(p=> { %>
          <%- include('../partials/user/product-card', { product: p }) %>
            <% }) %>
              <% } else { %>
                <p class="col-span-full text-center text-neutral-500 py-10">Check back soon for top sellers!</p>
                <% } %>
    </div>
  </section>

  <!-- CURATED BRANDS (DB – SAME DESIGN AS STATIC) -->
  <section class="mt-10 space-y-4 text-center">
    <h2 class="font-semibold text-lg">Our curated brands</h2>

    <p class="text-xs text-neutral-600 max-w-xl mx-auto">
      We partner with the world's most revered audio manufacturers to bring you an unparalleled listening experience.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 mt-4">
      <% if (brands && brands.length> 0) { %>

        <% brands.forEach(brand=> { %>
          <a href="/user/products?brand=<%= brand.slug %>">
            <%- include('../partials/user/brand-card', { name: brand.brandName }) %>
          </a>
          <% }) %>

            <% } else { %>
              <p class="text-xs text-neutral-400 col-span-full">
                No brands available
              </p>
              <% } %>
    </div>
  </section>


  <!-- SPECIAL OFFERS -->
  <section class="mt-10 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-extrabold text-3xl md:text-4xl tracking-tight">Special offers for you</h2>
      <a href="/user/products" class="inline-block">
      <button class="text-xs text-neutral-600">View all</button>
    </div></a>

    <!-- <div class="flex gap-2 text-[11px]">
      <span class="time-pill-active px-2 py-1 rounded-full">12d</span>
      <span class="time-pill px-2 py-1 rounded-full">10h</span>
      <span class="time-pill px-2 py-1 rounded-full">12m</span>
    </div> -->

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-3">
      <% specialOffers.forEach(product=> { %>
        <%- include('../partials/user/product-card', {product}) %>
          <% }) %>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="mt-16 w-full">
    <div class="w-full bg-[#0f172a] text-white rounded-[32px] px-8 md:px-20 py-16
                flex flex-col md:flex-row items-center justify-between gap-10 shadow-2xl">

      <div class="space-y-4 max-w-lg text-center md:text-left">
        <h2 class="text-3xl font-bold">Join the Inner Circle</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Stay tuned for exclusive releases, member-only drops, and the latest in high-fidelity audio engineering.
        </p>
      </div>

      <form class="w-full md:w-[450px] flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
            <i class="bi bi-envelope"></i>
          </span>
          <input type="email"
            class="w-full rounded-full pl-10 pr-4 py-3.5 text-sm text-black outline-none border-2 border-transparent focus:border-yellow-500 transition-colors"
            placeholder="Enter your email address" />
        </div>

        <button class="px-8 py-3.5 rounded-full bg-yellow-500 text-black 
                       text-sm font-bold hover:bg-yellow-400 transition-colors">
          Subscribe
        </button>
      </form>

    </div>
  </section>


</div>