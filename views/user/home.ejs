<link rel="stylesheet" href="/styles/user/home.css" />

<div class="max-w-7xl mx-auto px-4 pb-16 space-y-14 font-inter">

  <!-- HERO -->
  <section class="mt-6">
    <div class="relative bg-black text-white rounded-3xl overflow-hidden
                min-h-[260px] flex flex-col md:flex-row items-center
                px-8 md:px-10 py-10 gap-6">

      <div class="max-w-xl space-y-4">
        <p class="text-[11px] tracking-[0.25em] uppercase text-neutral-300">
          Premium Audio
        </p>
        <h1 class="text-3xl md:text-4xl font-semibold leading-tight">
          Experience Sound,<br class="hidden md:block" /> Redefined.
        </h1>
        <p class="text-sm md:text-base text-neutral-300 max-w-md">
          Discover curated headphones, speakers and IEMs crafted for audiophiles.
        </p>

        <button class="mt-2 inline-flex items-center px-5 py-2.5 rounded-full 
                       bg-yellow-500 text-black text-sm font-semibold hover:opacity-90">
          Explore the Collection
          <span class="material-icons text-[16px] ml-1">arrow_forward</span>
        </button>
      </div>
<!-- 
      <div class="flex-1 flex justify-end">
        <img src="/images/hero/headphones-hero.png"
             class="w-56 md:w-72 object-contain" />
      </div> -->

      <button class="hero-arrow hidden md:flex absolute left-4 top-1/2 
                     -translate-y-1/2 bg-neutral-900/70 text-white
                     rounded-full w-9 h-9 items-center justify-center">‹</button>

      <button class="hero-arrow hidden md:flex absolute right-4 top-1/2 
                     -translate-y-1/2 bg-neutral-900/70 text-white
                     rounded-full w-9 h-9 items-center justify-center">›</button>

      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
        <span class="w-2 h-2 rounded-full bg-white"></span>
        <span class="w-2 h-2 rounded-full bg-neutral-500"></span>
        <span class="w-2 h-2 rounded-full bg-neutral-500"></span>
      </div>
    </div>
  </section>

  <!-- SHOP BY CATEGORY -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-lg">Shop by category</h2>

      <div class="flex gap-2">
        <button class="w-8 h-8 rounded-full border flex items-center 
                       justify-center text-sm hover:bg-neutral-100">‹</button>
        <button class="w-8 h-8 rounded-full border flex items-center 
                       justify-center text-sm hover:bg-neutral-100">›</button>
      </div>
    </div>

    <div class="flex gap-6 overflow-x-auto pt-2 no-scrollbar">
      <% categories.forEach(cat => { %>
        <%- include('../partials/user/category-card', cat) %>
      <% }) %>
    </div>
  </section>

  <!-- SEASONAL SALE -->
  <section>
    <div class="bg-gradient-to-r from-blue-100 to-blue-200 rounded-3xl
                flex flex-col md:flex-row items-center p-6 md:p-10 gap-6">

      <div class="flex-1 flex flex-col md:flex-row items-center gap-6">
        <div>
          <p class="text-sm font-semibold text-brandBlue">20% OFF</p>
          <p class="text-xs text-neutral-600">On select products</p>
        </div>

        <div class="flex-1">
          <h3 class="font-semibold text-lg text-brandDark">
            Seasonal weekly sale 2025
          </h3>
          <p class="text-xs text-neutral-700">
            Use code 
            <span class="font-semibold bg-white/70 px-2 py-0.5 rounded-full
                         border text-[11px] uppercase">
              SALE2025
            </span>
            to get the best offer.
          </p>
        </div>
      </div>

      <img src="/images/banners/sale-headphones.png"
           class="w-40 md:w-48 object-contain" />
    </div>
  </section>

  <!-- SERVICE ICON ROW -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
    <%- include('../partials/user/service-icons') %>
  </section>

  <!-- TOP SELLING -->
  <section class="space-y-4">
    <h2 class="font-semibold text-lg mt-4">Top selling products</h2>

    <div class="flex gap-4 text-xs border-b">
      <button class="pb-2 border-b-2 border-black font-semibold">Headphones</button>
      <button class="pb-2 text-neutral-500">IEMs</button>
      <button class="pb-2 text-neutral-500">Speakers</button>
      <button class="pb-2 text-neutral-500">Earbuds</button>
      <button class="pb-2 text-neutral-500">Accessories</button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
      <% topProducts.forEach(product => { %>
        <%- include('../partials/user/product-card', { product } ) %>
      <% }) %>
    </div>
  </section>

  <!-- CURATED BRANDS -->
  <section class="mt-10 space-y-4 text-center">
    <h2 class="font-semibold text-lg">Our curated brands</h2>
    <p class="text-xs text-neutral-600 max-w-xl mx-auto">
      We partner with the world's most revered audio manufacturers to bring you an unparalleled listening experience.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 mt-4">
      <% curatedBrands.forEach(name => { %>
        <%- include('../partials/user/brand-card', { name }) %>
      <% }) %>
    </div>
  </section>

  <!-- SPECIAL OFFERS -->
  <section class="mt-10 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-lg">Special offers for you</h2>
      <button class="text-xs text-neutral-600">View all</button>
    </div>

    <div class="flex gap-2 text-[11px]">
      <span class="time-pill-active px-2 py-1 rounded-full">12d</span>
      <span class="time-pill px-2 py-1 rounded-full">10h</span>
      <span class="time-pill px-2 py-1 rounded-full">12m</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-3">
      <% specialOffers.forEach(product => { %>
        <%- include('../partials/user/product-card', {product}) %>
      <% }) %>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="mt-10 w-full">
    <div class="w-full bg-[#002366] text-white rounded-3xl px-6 md:px-12 py-10
                flex flex-col md:flex-row items-center justify-between gap-6">

      <div class="space-y-2 max-w-md">
        <h2 class="text-xl md:text-2xl font-semibold">Join the inner circle</h2>
        <p class="text-xs text-blue-100">
          Stay tuned for exclusive releases, special offers, and the latest in high-fidelity audio.
        </p>
      </div>

      <form class="w-full md:w-96 flex flex-col sm:flex-row gap-3">
        <input type="email"
               class="flex-1 rounded-full px-4 py-2 text-sm text-black outline-none"
               placeholder="Enter your email address" />

        <button class="px-5 py-2 rounded-full bg-yellow-400 text-black 
                       text-sm font-semibold hover:opacity-90">
          Subscribe
        </button>
      </form>

    </div>
  </section>

</div>
