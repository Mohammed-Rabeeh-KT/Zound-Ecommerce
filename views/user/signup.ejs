<link rel="stylesheet" href="/styles/user/signup.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />



<div class="signup-wrapper">

  <form id="signform" class="signup-card" action="/user/signup" method="POST">

    <h2 class="title">Create Your Account</h2>

    <p class="subtitle">
      Join the Zound community for an exclusive experience.
    </p>

    <!-- FULL NAME -->
    <label>Full Name </label>
    <input id="name" type="text" name="name" placeholder="Enter your full name" />
    <div id="error1" class="error-message"></div>


    <!-- EMAIL -->
    <label>Email Address </label>
    <input id="emailInput" type="email" name="email" placeholder="Enter your email address" />
    <div id="error2" class="error-message"></div>

    <!-- PASSWORD -->
    <label>Password </label>

    <div class="password-box">
      <input id="password" type="password" name="password" placeholder="Create a password" />
      <span id="togglePass" class="material-symbols-outlined eye-icon">visibility</span>
    </div>
    <div id="error3" class="error-message"></div>

    <!-- CONFIRM PASSWORD -->
    <label>Confirm Password </label>
    <div class="password-box">
      <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Confirm your password" />
      <span id="togglePass2" class="material-symbols-outlined eye-icon">visibility</span>
    </div>
    <div id="error4" class="error-message"></div>


    <!-- REFERRAL CODE -->
    <label>Referral Code <span style="font-size: 12px; color: #666;">(Optional)</span></label>
    <input id="referralCode" type="text" name="referralCode" placeholder="Enter referral code" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>" />

    <!-- SUBMIT BUTTON -->
    <button type="submit" class="signup-btn">Create Account</button>

    <!-- LOGIN LINK -->
    <p class="bottom-text">
      Already have an account?
      <a href="/user/login">Log In</a>
    </p>

  </form>

  <footer class="footer">
    <!-- <span>© 2025 Zound. All rights reserved.</span> -->
    <a href="/privacy">Privacy Policy</a>
  </footer>

</div>

<script src="/js/user/signup.js"></script>