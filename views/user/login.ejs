<link rel="stylesheet" href="/styles/user/userlogin.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />



<div class="login-wrapper">

    <form class="login-card" action="/user/login" method="POST">

        <h2 class="title">Welcome Back</h2>

        <!-- EMAIL -->
        <label>Email address </label>
        <input id="emailInput" type="email" name="email" placeholder="Enter your email address" />
        <div id="emailError" class="error-message"></div>

        <!-- PASSWORD -->
        <label>Password </label>
        <div class="password-box">
            <input id="passwordInput" type="password" name="password" placeholder="Enter your password" />
            <span id="togglePassword" class="material-symbols-outlined eye-icon">visibility</span>
        </div>
        <div id="passwordError" class="error-message"></div>

        <!-- REMEMBER + FORGOT -->
        <div class="row-between">
            <label class="remember">
                <input type="checkbox" name="remember" /> Remember me
            </label>
            <a href="/user/forgot-password" class="forgot">Forgot password?</a>
        </div>

        <!-- LOGIN BUTTON -->
        <button type="submit" class="login-btn">Login</button>

        <!-- DIVIDER -->
        <div class="divider-row">
            <div class="line"></div>
            <span>Or continue with</span>
            <div class="line"></div>
        </div>

        <!-- SOCIAL BUTTONS -->
        <div class="social-buttons">
            <a href="/auth/google" class="social-btn">
                <img src="/images/icons/google.svg" alt="Google sign-in" width="20" height="20" /> Sign in with Google
            </a>
            <!-- <button type="button" class="social-btn">
                <img src="/images/icons/facebook.svg" /> Facebook
            </button>
            <button type="button" class="social-btn">
                <img src="/images/icons/apple.svg" /> Apple
            </button> -->
        </div>

        <!-- SIGNUP LINK -->
        <div class="signup-row">
            <span>New to Zound?</span>
            <a href="/user/signup">Create an account</a>
        </div>

    </form>

    <footer class="footer">
        <a href="/privacy">Privacy Policy</a>
    </footer>

</div>

<script src="/js/user/login.js"></script>