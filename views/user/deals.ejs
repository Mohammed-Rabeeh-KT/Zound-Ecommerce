<link rel="stylesheet" href="/styles/user/deals.css">

<div class="deals-hero">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
        <svg class="deals-hero-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
        <h1 class="text-3xl md:text-4xl font-bold mb-3">Exclusive Deals & Offers</h1>
        <p class="text-gray-400 text-sm max-w-xl">Save big on premium audio equipment. Limited time offers you don't
            want to miss!</p>
    </div>
</div>

<main class="max-w-7xl mx-auto px-4 py-12">

    <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900">Active Deals</h2>
        <div class="text-sm text-gray-500 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            Deals refresh daily
        </div>
    </div>

    <% if (activeOffers && activeOffers.length> 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% activeOffers.forEach(offer=> { %>
                <div class="deal-card">
                    <div class="deal-image-container">
                        <!-- Simulated image using generic gradient or placeholder -->
                        <div class="w-full h-full bg-gradient-to-br from-indigo-100 to-slate-200"></div>

                        <span class="badge-featured">Featured Deal</span>
                        <span class="badge-discount">
                            <%= offer.discount_type==='percentage' ? offer.discount_value + '% OFF' : '₹' +
                                offer.discount_value + ' OFF' %>
                        </span>
                    </div>

                    <div class="p-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            <%= offer.title %>
                        </h3>
                        <p class="text-sm text-gray-500 line-clamp-2 mb-6">Enjoy incredible savings. Applies to <%=
                                offer.apply_for %> level purchases.</p>

                        <div class="flex items-center gap-2 text-sm text-gray-600 mb-6 font-medium">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            Expires in:
                            <span class="text-gray-900 font-bold">
                                <% const diffTime=Math.abs(new Date(offer.ends_at) - new Date()); const
                                    diffDays=Math.ceil(diffTime / (1000 * 60 * 60 * 24)); %>
                                    <%= diffDays %> days
                            </span>
                        </div>

                        <div class="flex items-center gap-3">
                            <div
                                class="flex-1 bg-yellow-50 text-yellow-800 text-xs font-bold py-2 px-3 rounded-md flex items-center justify-center gap-2 border border-yellow-200">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                                    <line x1="7" y1="7" x2="7.01" y2="7" />
                                </svg>
                                AUTO-APPLY
                            </div>
                            <a href="/user/products"
                                class="bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-bold py-2.5 px-6 rounded-md transition-colors shadow-sm">
                                Shop Now
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
        <% } else { %>
            <div class="text-center py-20 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                <h3 class="text-xl font-bold text-gray-700 mb-2">No active deals right now</h3>
                <p class="text-gray-500 text-sm">Check back later or subscribe to our newsletter for exclusive
                    offers!</p>
            </div>
            <% } %>

                <!-- Newsletter Section -->
                <section class="mt-20 text-center max-w-2xl mx-auto bg-white p-8 mb-8">
                    <h3 class="text-2xl font-bold text-gray-900 mb-3">Never Miss a Deal</h3>
                    <p class="text-gray-500 text-sm mb-8">Subscribe to our newsletter and be the first to know about
                        exclusive offers, flash sales, and new arrivals.</p>

                    <form class="flex max-w-md mx-auto relative shadow-sm border rounded-full p-1"
                        onsubmit="event.preventDefault(); window.showToast('Subscribed successfully!', 'success');">
                        <input type="email" placeholder="Enter your email" required
                            class="flex-1 bg-transparent border-none outline-none px-6 text-sm text-gray-700">
                        <button type="submit"
                            class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold text-sm px-6 py-3 rounded-full transition-colors absolute right-1 top-1 bottom-1">
                            Subscribe
                        </button>
                    </form>
                </section>

</main>