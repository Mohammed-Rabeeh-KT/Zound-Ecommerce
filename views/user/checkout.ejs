<!DOCTYPE html>
<html lang="en">

<head>
    <script>
        // Server-side injected variables
        window.SERVER_DATA = {
            appliedCouponCode: "<%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? appliedCoupon.code : '' %>",
            couponDiscount: <%= (typeof couponDiscount !== 'undefined') ? couponDiscount : 0 %>
        };
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | ZOUND</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/styles/user/checkout.css">
    <link rel="stylesheet" href="/styles/user/addresses.css">
</head>

<body>
    <div class="checkout-page">
        <!-- Progress Steps -->
        <div class="checkout-progress">
            <div class="progress-container">
                <div class="progress-step completed">
                    <div class="step-icon">
                        <span class="material-icons">shopping_cart</span>
                    </div>
                    <span class="step-label">Cart</span>
                </div>
                <div class="progress-line completed"></div>
                <div class="progress-step active">
                    <div class="step-icon">
                        <span class="material-icons">local_shipping</span>
                    </div>
                    <span class="step-label">Checkout</span>
                </div>
                <div class="progress-line"></div>
                <div class="progress-step">
                    <div class="step-icon">
                        <span class="material-icons">check_circle</span>
                    </div>
                    <span class="step-label">Confirmation</span>
                </div>
            </div>
        </div>

        <main class="checkout-container">
            <div class="checkout-header">
                <a href="/user/cart" class="back-link">
                    <span class="material-icons">arrow_back</span>
                    Back to Cart
                </a>
                <h1 class="checkout-title">Checkout</h1>
            </div>

            <div class="checkout-content">
                <!-- Left Column - Delivery & Payment -->
                <div class="checkout-main">
                    <!-- Delivery Address Section -->
                    <section class="checkout-section" id="addressSection">
                        <div class="section-header">
                            <div class="section-title">
                                <span class="section-number">1</span>
                                <h2>Delivery Address</h2>
                            </div>
                            <% if (addresses && addresses.length> 0) { %>
                                <button class="add-new-btn" onclick="showAddAddressModal()">
                                    <span class="material-icons">add</span>
                                    Add New
                                </button>
                                <% } %>
                        </div>

                        <% if (!addresses || addresses.length===0) { %>
                            <!-- No Addresses State -->
                            <div class="empty-addresses">
                                <div class="empty-icon">
                                    <span class="material-icons">location_off</span>
                                </div>
                                <h3>No saved addresses</h3>
                                <p>Add a delivery address to continue with checkout</p>
                                <button class="btn-primary" onclick="showAddAddressModal()">
                                    <span class="material-icons">add_location</span>
                                    Add New Address
                                </button>
                            </div>
                            <% } else { %>
                                <!-- Address Cards -->
                                <div class="address-grid">
                                    <% for (var i=0; i < addresses.length; i++) { var addr=addresses[i]; var
                                        isSelected=(selectedAddress && selectedAddress.toString()===addr._id.toString())
                                        || addr.isDefault; %>
                                        <div class="address-card <%= isSelected ? 'selected' : '' %> <%= addr.isDefault ? 'default' : '' %>"
                                            data-address-id="<%= addr._id %>" data-id="<%= addr._id %>"
                                            onclick="selectAddress('<%= addr._id %>')">
                                            <div class="address-radio">
                                                <input type="radio" name="deliveryAddress" id="addr_<%= addr._id %>"
                                                    value="<%= addr._id %>" <%=isSelected ? 'checked' : '' %>>
                                            </div>
                                            <div class="address-content">
                                                <div class="address-header">
                                                    <span class="address-label <%= addr.label.toLowerCase() %>">
                                                        <%= addr.label %>
                                                    </span>
                                                    <% if (addr.isDefault) { %>
                                                        <span class="default-badge">Default</span>
                                                        <% } %>
                                                </div>
                                                <h4 class="address-name">
                                                    <%= addr.fullName %>
                                                </h4>
                                                <p class="address-text">
                                                    <%= addr.addressLine1 %>
                                                        <% if (addr.addressLine2) { %>, <%= addr.addressLine2 %>
                                                                <% } %>
                                                </p>
                                                <p class="address-text">
                                                    <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                                                </p>
                                                <p class="address-phone">
                                                    <span class="material-icons">phone</span>
                                                    <%= addr.phone %>
                                                        <% if (addr.altPhone) { %>, <%= addr.altPhone %>
                                                                <% } %>
                                                </p>
                                            </div>
                                            <div class="address-actions">
                                                <button class="edit-btn"
                                                    onclick="event.stopPropagation(); editAddress('<%= addr._id %>')">
                                                    <span class="material-icons">edit</span>
                                                </button>
                                                <% if (addresses.length> 1) { %>
                                                    <button class="delete-btn"
                                                        onclick="event.stopPropagation(); deleteAddressCheckout('<%= addr._id %>')">
                                                        <span class="material-icons">delete</span>
                                                    </button>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                                <% } %>

                                    <!-- Add/Edit Address Form Dropdown -->
                                    <%- include('../partials/user/address-form') %>
                    </section>

                    <!-- Payment Method Section -->
                    <section class="checkout-section" id="paymentSection">
                        <div class="section-header">
                            <div class="section-title">
                                <span class="section-number">2</span>
                                <h2>Payment Method</h2>
                            </div>
                        </div>

                        <div class="payment-methods">
                            <!-- Razorpay -->
                            <div class="payment-option selected" data-method="razorpay"
                                onclick="selectPayment('razorpay')">
                                <div class="payment-radio">
                                    <input type="radio" name="paymentMethod" id="razorpay" value="razorpay" checked>
                                </div>
                                <div class="payment-content">
                                    <div class="payment-icon razorpay"
                                        style="background-color: #2B84EA; width: 48px; height: 48px; padding: 6px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                        <img src="https://razorpay.com/assets/razorpay-glyph.svg" alt="Razorpay"
                                            style="width: 36px; height: 36px; filter: brightness(0) invert(1);">
                                    </div>
                                    <div class="payment-info">
                                        <h4>Pay with Razorpay</h4>
                                        <p>Credit/Debit Card, UPI, Netbanking, Wallets</p>
                                    </div>
                                </div>
                                <span class="payment-tag recommended">Recommended</span>
                            </div>

                            <!-- Wallet -->
                            <div class="payment-option" data-method="wallet" onclick="selectPayment('wallet')">
                                <div class="payment-radio">
                                    <input type="radio" name="paymentMethod" id="wallet" value="wallet">
                                </div>
                                <div class="payment-content">
                                    <div class="payment-icon wallet">
                                        <span class="material-icons">account_balance_wallet</span>
                                    </div>
                                    <div class="payment-info">
                                        <h4>ZOUND Wallet</h4>
                                        <p>Balance: ₹<%= walletBalance ? Number(walletBalance).toFixed(2) : '0.00' %>
                                        </p>
                                    </div>
                                </div>
                                <% if (walletBalance < cartTotal) { %>
                                    <span class="payment-tag insufficient">Insufficient Balance</span>
                                    <% } %>
                            </div>

                            <!-- Cash on Delivery -->
                            <% var isCodDisabled=cartTotal> 1000; %>
                                <div class="payment-option <%= isCodDisabled ? 'disabled' : '' %>" data-method="cod"
                                    onclick="<%= isCodDisabled ? '' : 'selectPayment(\'cod\')' %>">
                                    <div class="payment-radio">
                                        <input type="radio" name="paymentMethod" id="cod" value="cod" <%=isCodDisabled
                                            ? 'disabled' : '' %>>
                                    </div>
                                    <div class="payment-content">
                                        <div class="payment-icon cod">
                                            <span class="material-icons">payments</span>
                                        </div>
                                        <div class="payment-info">
                                            <h4>Cash on Delivery</h4>
                                            <p>
                                                <%= isCodDisabled ? 'Not available for orders above ₹1,000'
                                                    : 'Pay when you receive your order' %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                    </section>
                </div>

                <!-- Right Column - Order Summary -->
                <aside class="checkout-sidebar">
                    <div class="order-summary-card">
                        <h3 class="summary-title">Order Summary</h3>

                        <!-- Cart Items Preview -->
                        <div class="summary-items">
                            <% for (var i=0; i < cart.items.length; i++) { %>

                                <% var item=cart.items[i]; var variant=item.variant || null; %>

                                    <% if (!variant && item.productId && item.productId.variants && item.variantId) { %>
                                        <% for (var v=0; v < item.productId.variants.length; v++) { %>
                                            <% if (
                                                item.productId.variants[v]._id.toString()===item.variantId.toString() )
                                                { %>
                                                <% variant=item.productId.variants[v]; break; %>
                                                    <% } %>
                                                        <% } %>
                                                            <% } %>

                                                                <% if ( !variant && item.productId &&
                                                                    item.productId.variants &&
                                                                    item.productId.variants.length> 0
                                                                    ) { %>
                                                                    <% variant=item.productId.variants[0]; %>
                                                                        <% } %>

                                                                            <% var itemImage="/images/placeholder.png" ;
                                                                                if (variant && variant.images &&
                                                                                variant.images.length> 0) {
                                                                                itemImage = variant.images[0];
                                                                                } else if (
                                                                                item.productId &&
                                                                                item.productId.productImages &&
                                                                                item.productId.productImages.length > 0
                                                                                ) {
                                                                                itemImage =
                                                                                item.productId.productImages[0];
                                                                                }

                                                                                var itemPrice = item.effectivePrice ||
                                                                                (variant ? variant.salePrice : 0);
                                                                                var originalPrice = variant ?
                                                                                variant.salePrice : 0;
                                                                                %>

                                                                                <div class="summary-item">
                                                                                    <div class="item-image">
                                                                                        <img src="<%= itemImage %>"
                                                                                            alt="<%= item.productId ? item.productId.productName : item.product.productName %>">
                                                                                        <span class="item-qty">
                                                                                            <%= item.quantity %>
                                                                                        </span>
                                                                                        <% if (item.offer &&
                                                                                            item.offer.hasOffer) { %>
                                                                                            <span
                                                                                                class="item-offer-badge">
                                                                                                <% if
                                                                                                    (item.offer.discountType==='percentage'
                                                                                                    ) { %>
                                                                                                    <%= item.offer.discount
                                                                                                        %>% OFF
                                                                                                        <% } else { %>
                                                                                                            ₹<%= item.offer.discount
                                                                                                                %> OFF
                                                                                                                <% } %>
                                                                                            </span>
                                                                                            <% } %>
                                                                                    </div>

                                                                                    <div class="item-details">
                                                                                        <h4>
                                                                                            <%= item.productId ?
                                                                                                item.productId.productName
                                                                                                :
                                                                                                item.product.productName
                                                                                                %>
                                                                                        </h4>

                                                                                        <% if (variant && variant.value)
                                                                                            { %>
                                                                                            <span class="item-variant">
                                                                                                <%= variant.value %>
                                                                                            </span>
                                                                                            <% } %>
                                                                                    </div>

                                                                                    <div class="item-price">
                                                                                        <% if (item.offer &&
                                                                                            item.offer.hasOffer) { %>
                                                                                            <span
                                                                                                class="offer-final-price">₹
                                                                                                <%= Number(item.effectiveTotalPrice).toFixed(2)
                                                                                                    %>
                                                                                            </span>
                                                                                            <span
                                                                                                class="original-item-price">₹
                                                                                                <%= Number(item.offer.salePrice
                                                                                                    *
                                                                                                    item.quantity).toFixed(2)
                                                                                                    %>
                                                                                            </span>
                                                                                            <% } else { %>
                                                                                                ₹<%= Number(itemPrice *
                                                                                                    item.quantity).toFixed(2)
                                                                                                    %>
                                                                                                    <% } %>
                                                                                    </div>
                                                                                </div>

                                                                                <% } %>
                        </div>


                        <div class="summary-divider"></div>

                        <!-- Price Breakdown -->
                        <div class="price-breakdown">
                            <div class="price-row">
                                <span>Subtotal (<%= cart.items.length %> items)</span>
                                <span id="subtotalAmount">₹<%= Number(cartSubtotal).toFixed(2) %></span>
                            </div>
                            <div class="price-row discount" id="discountRow"
                                style="display: <%= (typeof couponDiscount !== 'undefined' && couponDiscount > 0) ? 'flex' : 'none' %>;">
                                <span>Coupon Discount</span>
                                <span class="discount-amount" id="discountAmount">-₹<%= (typeof couponDiscount
                                        !=='undefined' ) ? Number(couponDiscount).toFixed(2) : '0.00' %></span>
                            </div>
                            <div class="price-row">
                                <span>Shipping</span>
                                <span id="shippingAmount">
                                    <%= shippingCharge> 0 ? '₹' + Number(shippingCharge).toFixed(2) : 'FREE' %>
                                </span>
                            </div>
                            <% if (shippingCharge===0) { %>
                                <div class="free-shipping-note">
                                    <span class="material-icons">local_shipping</span>
                                    Free shipping on orders above ₹500!
                                </div>
                                <% } %>
                        </div>

                        <div class="summary-divider"></div>

                        <!-- Coupon Section (Inside Order Summary) -->
                        <div class="coupon-section">
                            <div class="coupon-header" onclick="toggleCouponSection()">
                                <div class="coupon-header-left">
                                    <span class="material-icons">local_offer</span>
                                    <span>Apply Coupon</span>
                                </div>
                                <span class="material-icons coupon-arrow">expand_more</span>
                            </div>

                            <div class="coupon-body" id="couponBody">
                                <!-- Input Row -->
                                <div class="coupon-input-row"
                                    style="display: <%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? 'none' : 'flex' %>;">
                                    <input type="text" id="couponCode" placeholder="Enter code" maxlength="20">
                                    <button class="apply-btn" onclick="applyCoupon()">Apply</button>
                                </div>

                                <!-- Applied Coupon Display -->
                                <div class="applied-coupon-display" id="appliedCoupon"
                                    style="display: <%= (typeof appliedCoupon !== 'undefined' && appliedCoupon) ? 'flex' : 'none' %>;">
                                    <div class="applied-info">
                                        <span class="material-icons">check_circle</span>
                                        <div>
                                            <span class="coupon-name" id="appliedCouponName">
                                                <%= (typeof appliedCoupon !=='undefined' && appliedCoupon) ?
                                                    appliedCoupon.code : '' %>
                                            </span>
                                            <span class="coupon-savings" id="couponSavings">Saving ₹<%= (typeof
                                                    couponDiscount !=='undefined' ) ? Number(couponDiscount).toFixed(2)
                                                    : '0.00' %></span>
                                        </div>
                                    </div>
                                    <button class="remove-btn" onclick="removeCoupon()">
                                        <span class="material-icons">close</span>
                                    </button>
                                </div>

                                <!-- Available Coupons List -->
                                <% if (availableCoupons && availableCoupons.length> 0) { %>
                                    <div class="available-coupons-compact">
                                        <span class="available-label">Available:</span>
                                        <% for (var c=0; c < availableCoupons.length; c++) { var
                                            coupon=availableCoupons[c]; %>
                                            <button class="coupon-chip" onclick="applyCouponCode('<%= coupon.code %>')">
                                                <%= coupon.code %>
                                                    <span class="chip-discount">
                                                        <% if (coupon.type==='percentage' ) { %>
                                                            <%= coupon.value %>%
                                                                <% } else { %>
                                                                    ₹<%= coupon.value %>
                                                                        <% } %>
                                                    </span>
                                            </button>
                                            <% } %>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <div class="summary-divider"></div>

                        <!-- Total -->
                        <div class="total-row">
                            <span>Total Amount</span>
                            <span class="total-amount" id="totalAmount">₹<%= Number(cartTotal).toFixed(2) %></span>
                        </div>

                        <!-- Place Order Button -->
                        <button class="place-order-btn" id="placeOrderBtn" onclick="placeOrder()">
                            <span class="btn-text">Place Order</span>
                            <span class="material-icons">arrow_forward</span>
                        </button>

                        <!-- Security Note -->
                        <div class="security-note">
                            <span class="material-icons">lock</span>
                            <span>Secure checkout powered by 256-bit encryption</span>
                        </div>
                    </div>

                    <!-- Trust Badges -->
                    <div class="trust-badges">
                        <div class="badge">
                            <span class="material-icons">verified</span>
                            <span>100% Genuine</span>
                        </div>
                        <div class="badge">
                            <span class="material-icons">autorenew</span>
                            <span>Easy Returns</span>
                        </div>
                        <div class="badge">
                            <span class="material-icons">support_agent</span>
                            <span>24/7 Support</span>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
    </div>

    <!-- Hidden Data -->
    <input type="hidden" id="selectedAddressId" value="<%= selectedAddress || '' %>">
    <input type="hidden" id="cartTotal" value="<%= cartTotal %>">
    <input type="hidden" id="cartSubtotal" value="<%= cartSubtotal %>">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script src="/js/user/addresses.js"></script>
    <script src="/js/user/checkout.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</body>

</html>