<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payments | ZOUND Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/styles/admin/paymentManagement.css">
</head>

<body>
    <%- include('../partials/admin/adminSidebar', { currentPage: currentPage, adminName: adminName }) %>

        <div class="main-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Payments</h1>
                    <p class="page-subtitle">Manage payment transactions</p>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <h3>Total Transactions</h3>
                        <p class="stat-value">
                            <%= totalTransactions %>
                        </p>
                        <span class="stat-change positive">+15% from last month</span>
                    </div>
                    <div class="stat-icon bg-blue">
                        <i class="bi bi-credit-card"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h3>Revenue</h3>
                        <p class="stat-value">₹<%= revenue.toLocaleString('en-IN') %>
                        </p>
                        <span class="stat-change positive">+22% from last month</span>
                    </div>
                    <div class="stat-icon bg-green">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-info">
                        <h3>Refunds</h3>
                        <p class="stat-value">₹<%= refunds.toLocaleString('en-IN') %>
                        </p>
                        <span class="stat-change negative">+5% from last month</span>
                    </div>
                    <div class="stat-icon bg-red">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                </div>
            </div>

            <div class="action-bar">
                <a href="/admin/refunds" class="view-refunds-link">
                    View Refund Details <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <!-- Payments Table -->
            <div class="table-card">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Payment ID</th>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length> 0) { %>
                            <% orders.forEach(order=> { %>
                                <tr>
                                    <td>PAY-<%= order.orderId.split('-')[2] %>
                                    </td>
                                    <td><a href="/admin/orders/<%= order._id %>" class="order-link">
                                            <%= order.orderId %>
                                        </a></td>
                                    <td>
                                        <div class="user-info">
                                            <span class="user-name">
                                                <%= order.userId ? order.userId.name : 'Unknown' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td><strong>₹<%= order.finalAmount.toFixed(2) %></strong></td>
                                    <td>
                                        <%= order.paymentMethod %>
                                    </td>
                                    <td>
                                        <% let statusClass='pending' ; if(order.paymentStatus==='Paid' )
                                            statusClass='completed' ; else if(order.paymentStatus==='Failed' )
                                            statusClass='failed' ; else if(order.paymentStatus==='Refunded' )
                                            statusClass='refunded' ; %>
                                            <span class="status-badge status-<%= statusClass %>">
                                                <%= order.paymentStatus %>
                                            </span>
                                    </td>
                                    <td>
                                        <%= new Date(order.createdOn).toISOString().split('T')[0] %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="empty-state">No transactions found</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages> 1) { %>
                <div class="pagination-container">
                    <% if (page> 1) { %>
                        <a href="?page=<%= page - 1 %>" class="page-btn"><i class="bi bi-chevron-left"></i></a>
                        <% } %>

                            <% for(let i=1; i <=totalPages; i++) { %>
                                <a href="?page=<%= i %>" class="page-btn <%= page === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                                <% } %>

                                    <% if (page < totalPages) { %>
                                        <a href="?page=<%= page + 1 %>" class="page-btn"><i
                                                class="bi bi-chevron-right"></i></a>
                                        <% } %>
                </div>
                <% } %>

        </div>
</body>

</html>