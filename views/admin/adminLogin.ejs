<link rel="stylesheet" href="/styles/admin/adminlogin.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

<div class="admin-login-wrapper">

    <div class="admin-login-container">



        <!-- LOGIN CARD -->
        <form class="admin-login-card" action="/admin/login" method="POST">

            <!-- BRAND HEADER -->
            <div class="brand-header">
                <h1 class="brand-name">ZOUND</h1>
                <p class="brand-subtitle">Admin Portal</p>
            </div>

            <h2 class="welcome-title">Welcome Back</h2>
            <p class="welcome-subtitle">Sign in to manage your admin dashboard</p>

            <!-- EMAIL -->
            <label class="input-label">Email Address</label>
            <input id="emailInput" type="email" name="email" class="admin-input" placeholder="Enter your email" />
            <div class="error-message" id="emailError"></div>
            <% if (typeof errors !=='undefined' && errors && errors.email) { %>
                <p class="server-error-msg">
                    <%= errors.email %>
                </p>
                <% } %>

                    <!-- PASSWORD -->
                    <label class="input-label">Password</label>
                    <div class="password-wrapper">
                        <input id="passwordInput" type="password" name="password" class="admin-input" placeholder="Enter your password" />
                        <span id="togglePassword" class="material-symbols-outlined eye-toggle">visibility_off</span>
                    </div>
                    <div class="error-message" id="passwordError"></div>
                    <% if (typeof errors !=='undefined' && errors && errors.password) { %>
                        <p class="server-error-msg">
                            <%= errors.password %>
                        </p>
                        <% } %>

                            <!-- LOGIN BUTTON -->
                            <button type="submit" class="admin-login-btn">Login</button>

                            <!-- SECURITY FOOTER -->
                            <p class="security-text">protected by industry-leading security protocols</p>

                            <!-- SUPPORT LINKS -->
                            <div class="support-links">
                                <span>Need help?</span>
                                <a href="/admin/contact-support" class="support-link">Contact Support</a>
                            </div>

                            <% if (typeof message !=='undefined' && message) { %>
                                <p class="server-error-msg">
                                    <%= message %>
                                </p>
                                <% } %>

        </form>

    </div>

</div>


<!-- Pass server data to JavaScript -->
<script>
    window.__adminLoginData = {
        successMessage: "<%= typeof successMessage !== 'undefined' ? successMessage : '' %>",
        redirectTo: "<%= typeof redirectTo !== 'undefined' ? redirectTo : '' %>"
    };
</script>

<script src="/js/admin/adminLogin.js"></script>