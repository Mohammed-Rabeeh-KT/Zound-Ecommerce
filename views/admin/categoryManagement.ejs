<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Categories Management</title>
    <link rel="stylesheet" href="/styles/admin/categoryManagement.css" />
</head>
<body>
    <%- include("../partials/admin/adminSidebar") %>

    <div class="main-content" id="categoryPageRoot">
        <!-- HEADER -->
        <div class="header">
            <div class="header-left">
                <h1 class="page-title">Categories Management</h1>
                <p class="page-subtitle">Manage product categories for the audiophile boutique.</p>
            </div>

            <button class="add-category-btn" id="addCategoryBtn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add Category
            </button>
        </div>

        <!-- SEARCH + FILTER -->
        <form id="searchForm" method="GET" action="/admin/categories">
            <div class="search-container">
                <div class="search-wrapper">
                    <span class="search-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                             viewBox="0 0 24 24" fill="none" stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>

                    <input
                        type="text"
                        id="searchInput"
                        name="search"
                        class="search-input"
                        value="<%= search || '' %>"
                        placeholder="Search by category name..."
                    />

                    <span class="clear-icon" id="clearSearchIcon" style="display:none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </span>
                </div>

                <div class="status-filter">
                    <select id="statusSelect" name="status" class="status-select">
                        <option value="">Status: All</option>
                        <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>
            </div>
        </form>

        <!-- TABLE -->
        <div class="table-container">
            <table class="categories-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th class="product-count-header">Product Count</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="categoriesTableBody"></tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="pagination" id="paginationContainer"></div>
    </div>

    <!-- ADD CATEGORY MODAL -->
    <div class="modal-overlay" id="addCategoryModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="#1e3a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add New Category
                </h2>
                <button class="modal-close" data-close="addCategoryModal" aria-label="Close add modal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <p class="modal-subtitle">Create a new product category.</p>

            <form id="addCategoryForm">
                <div class="form-group">
                    <label>Category Name <span class="required">*</span></label>
                    <input type="text" name="name" placeholder="e.g., Headphones" required />
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" rows="4" placeholder="Brief description of the category..."></textarea>
                </div>

             <div class="form-group">
    <label>Status</label>
    <div class="toggle-wrapper">
        <span class="toggle-label inactive-label">Inactive</span>

        <label class="toggle-switch">
            <input type="checkbox" id="addCategoryStatus" name="isListed" checked />
            <span class="toggle-slider"></span>
        </label>

        <span class="toggle-label active-label">Active</span>
    </div>
</div>

                <div class="modal-actions">
                    <button type="button" class="btn-cancel" data-close="addCategoryModal">Cancel</button>
                    <button type="submit" class="btn-save">Add Category</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FULL DESCRIPTION MODAL -->
<div class="modal-overlay" id="descModal">
    <div class="full-desc-popup">
        <button class="full-desc-close" onclick="closeDescModal()">✕</button>
        <h3 style="margin-bottom:10px;">Full Description</h3>
        <p id="fullDescText"></p>
    </div>
</div>


    <!-- EDIT CATEGORY MODAL -->
    <div class="modal-overlay" id="editCategoryModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="#1e3a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5l4 4L7 21H3v-4z"></path>
                    </svg>
                    Edit Category
                </h2>
                <button class="modal-close" data-close="editCategoryModal" aria-label="Close edit modal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <p class="modal-subtitle">Update category information and status.</p>

            <form id="editCategoryForm">
                <input type="hidden" id="editCategoryId" name="id" />

                <div class="form-group">
                    <label>Category Name <span class="required">*</span></label>
                    <input type="text" id="editCategoryName" name="name" required />
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea id="editCategoryDescription" name="description" rows="4"></textarea>
                </div>

              <div class="form-group">
                    <label>Status</label>
                    <div class="toggle-wrapper">
                        <span class="toggle-label inactive-label">Inactive</span>

                        <label class="toggle-switch">
                            <input type="checkbox" id="addCategoryStatus" name="isListed" checked />
                            <span class="toggle-slider"></span>
                        </label>

                        <span class="toggle-label active-label">Active</span>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" data-close="editCategoryModal">Cancel</button>
                    <button type="submit" class="btn-save">Update Category</button>
                </div>
            </form>
        </div>
    </div>

    <!-- DELETE (soft-unlist) -->
<div class="modal-overlay" id="toggleModal">
    <div class="modal-content modal-small">
        
        <div id="toggleModalIcon" class="delete-icon"></div>

        <h2 id="toggleModalTitle" class="delete-title"></h2>
        <p class="delete-message">
            Are you sure you want to <strong id="toggleModalAction"></strong>
            <strong id="toggleCategoryName"></strong>?
        </p>

        <input type="hidden" id="toggleCategoryId" />

        <div class="modal-actions">
            <button type="button" class="btn-cancel" data-close="toggleModal">Cancel</button>
            <button type="button" class="btn-delete" id="confirmToggleBtn"></button>
        </div>
    </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="/js/admin/categoryManagement.js"></script>
</body>
</html>
