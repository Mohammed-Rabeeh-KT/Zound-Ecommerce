<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management | ZOUND Admin</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>

    <!-- Sidebar -->
    <%- include('../partials/admin/adminSidebar') %>

        <!-- Custom CSS -->
        <link rel="stylesheet" href="/styles/admin/ordermanagement.css">

        <div class="main-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Order Management</h1>
                    <p class="page-subtitle">Track and manage customer orders</p>
                </div>
            </div>

            <!-- Search & Filters -->
            <div class="filters-container">
                <!-- Search -->
                <div class="search-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-input" placeholder="Search by Order ID, Customer Name..." value="<%= typeof filters.search !== 'undefined' ? filters.search : '' %>"
                        onkeypress="if(event.key === 'Enter') applyFilter('search', this.value)">

                    <% if(typeof filters.search !=='undefined' && filters.search) { %>
                        <button class="clear-search" onclick="applyFilter('search', '')" title="Clear Search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                        <% } %>
                </div>

                <!-- payment Filter -->
                 <select class="filter-select" onchange="applyFilter('paymentMethod', this.value)">
                                        <option value="">Payment: All</option>
                    <option value="Wallet" <%=filters.paymentMethod==='Wallet' ? 'selected' : '' %>>Wallet</option>
                    <option value="Razorpay" <%=filters.paymentMethod==='Razorpay' ? 'selected' : '' %>>Razorpay</option>
                    <option value="COD" <%=filters.paymentMethod==='COD' ? 'selected' : '' %>>COD</option>

                 </select>

                <!-- payment Filter -->


                 

                <!-- Status Filter -->
                <select class="filter-select" onchange="applyFilter('status', this.value)">
                    <option value="">Status: All</option>
                    <option value="Pending" <%=filters.status==='Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Processing" <%=filters.status==='Processing' ? 'selected' : '' %>>Processing</option>
                    <option value="Shipped" <%=filters.status==='Shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="Delivered" <%=filters.status==='Delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="Cancelled" <%=filters.status==='Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    <option value="Return Request" <%=filters.status==='Return Request' ? 'selected' : '' %>>Return Requests</option>
                    <option value="Returned" <%=filters.status==='Returned' ? 'selected' : '' %>>Returned</option>
                </select>

                <!-- Date Filter -->
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="date" class="filter-select" title="Start Date" value="<%= typeof filters.startDate !== 'undefined' ? filters.startDate : '' %>" onchange="applyFilter('startDate', this.value)">
                    <span style="color: #64748b; font-size: 13px;">to</span>
                    <input type="date" class="filter-select" title="End Date" value="<%= typeof filters.endDate !== 'undefined' ? filters.endDate : '' %>" onchange="applyFilter('endDate', this.value)">
                </div>

                <!-- Sort is implicit (Desc by date), but could add if needed. Requirement said "List order in desc order by order date" (implied default) -->
                <!-- We could add a clear all filters button if complex -->
                <% if(filters.status || filters.search) { %>
                    <a href="/admin/orders" class="btn-reset">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset Filters
                    </a>
                    <% } %>
            </div>

            <!-- Orders Table -->
            <div class="table-card">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th width="5%">#</th>
                            <th width="15%">Order ID / Date</th>
                            <th width="25%">Customer</th>
                            <th width="15%">Amount</th>
                            <th width="15%">Payment</th>
                            <th width="15%">Status</th>
                            <th width="10%" style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders && orders.length> 0) { %>
                            <% orders.forEach((order, index)=> { %>
                                <tr>
                                    <td>
                                        <%= (pagination.currentPage - 1) * pagination.limit + index + 1 %>
                                    </td>
                                    <td>
                                        <span class="order-id">
                                            <%= order.orderId %>
                                        </span>
                                        <span class="order-date">
                                            <%= new Date(order.createdOn).toLocaleDateString('en-IN', { day: 'numeric' ,
                                                month: 'short' , year: 'numeric' , hour: '2-digit' , minute:'2-digit' })
                                                %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="user-info">
                                            <span class="user-name">
                                                <%= order.userId ? order.userId.name : 'Unknown User' %>
                                            </span>
                                            <span class="user-email">
                                                <%= order.userId ? order.userId.email : 'No email' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <strong>₹<%= order.finalAmount.toFixed(2) %></strong>
                                        <br>
                                        <span style="font-size: 0.8rem; color: #64748b;">
                                            <%= order.orderedItems.length %> Item<%= order.orderedItems.length !==1
                                                    ? 's' : '' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge"
                                            style="background:#f1f5f9; padding:4px 8px; border-radius:4px; font-size:12px; font-weight:500;">
                                            <%= order.paymentMethod %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (order.status==='Return Request' ) { %>
                                            <!-- For Return Request, show a badge and direct to details -->
                                            <span class="status-badge status-ReturnRequest">
                                                Return Request
                                            </span>
                                            <% } else if (order.status==='Returned' ) { %>
                                                <!-- Returned orders - show static badge -->
                                                <span class="status-badge status-Returned">
                                                    Returned
                                                </span>
                                                <% } else { %>
                                                    <!-- Status Dropdown for other statuses -->
                                                    <div class="status-select-wrapper">
                                                        <select class="status-select status-<%= order.status.replace(' ', '') %>"
                                                            onchange="updateOrderStatus('<%= order._id %>', this.value, '<%= order.status %>')">

                                                            <% const statuses=['Pending', 'Processing' , 'Shipped'
                                                                , 'Delivered' , 'Cancelled' ]; %>
                                                                <% statuses.forEach(s=> { %>
                                                                    <option value="<%= s %>" <%=order.status===s
                                                                        ? 'selected' : '' %>>
                                                                        <%= s %>
                                                                    </option>
                                                                    <% }) %>
                                                        </select>
                                                    </div>
                                                    <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <% if (order.status==='Return Request' ) { %>
                                            <!-- Prominent Review Return button -->
                                            <a href="/admin/orders/<%= order._id %>" class="review-return-btn"
                                                title="Review Return Request">
                                                <i class="bi bi-arrow-return-left"></i> Review
                                            </a>
                                            <% } else { %>
                                                <a href="/admin/orders/<%= order._id %>" class="action-btn"
                                                    title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7">
                                                <div class="no-results">
                                                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                                    <h3>No orders found</h3>
                                                    <p>Try adjusting your search or filters.</p>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (pagination.totalPages> 1) { %>
                <div class="pagination">
                    <% if (pagination.hasPrevPage) { %>
                        <a href="javascript:void(0)" onclick="applyFilter('page', '<%= pagination.currentPage - 1 %>')"
                            class="page-btn">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <% } %>

                            <% let startPage=Math.max(1, pagination.currentPage - 2); let
                                endPage=Math.min(pagination.totalPages, pagination.currentPage + 2); if (startPage> 1) {
                                %>
                                <a href="javascript:void(0)" onclick="applyFilter('page', '1')" class="page-btn">1</a>
                                <% if (startPage> 2) { %> <span class="page-btn" style="border:none;">...</span>
                                    <% } %>
                                        <% } for (let i=startPage; i <=endPage; i++) { %>
                                            <a href="javascript:void(0)" onclick="applyFilter('page', '<%= i %>')"
                                                class="page-btn <%= pagination.currentPage === i ? 'active' : '' %>">
                                                <%= i %>
                                            </a>
                                            <% } if (endPage < pagination.totalPages) { %>
                                                <% if (endPage < pagination.totalPages - 1) { %> <span class="page-btn"
                                                        style="border:none;">...</span>
                                                    <% } %>
                                                        <a href="javascript:void(0)"
                                                            onclick="applyFilter('page', '<%= pagination.totalPages %>')"
                                                            class="page-btn">
                                                            <%= pagination.totalPages %>
                                                        </a>
                                                        <% } %>

                                                            <% if (pagination.hasNextPage) { %>
                                                                <a href="javascript:void(0)"
                                                                    onclick="applyFilter('page', '<%= pagination.currentPage + 1 %>')"
                                                                    class="page-btn">
                                                                    <i class="bi bi-chevron-right"></i>
                                                                </a>
                                                                <% } %>
                </div>
                <% } %>

        </div>

        <!-- Scripts -->
        <script src="/js/admin/orderManagement.js"></script>

</body>

</html>