<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Banner Management</title>
    <link rel="stylesheet" href="/styles/admin/bannerManagement.css" />
</head>

<body>
    <%- include("../partials/admin/adminSidebar") %>

        <div class="main-content">
            <div class="header">
                <div class="header-left">
                    <h1 class="page-title">Banner Management</h1>
                    <p class="page-subtitle">Manage dynamic banners for your website</p>
                </div>

                <button class="add-banner-btn" id="addBannerBtn" onclick="openAddModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Banner
                </button>
            </div>

            <div class="search-container">
                <div class="search-wrapper">
                    <span class="search-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>

                    <input type="text" id="searchInput" class="search-input" value="<%= search || '' %>"
                        placeholder="Search banners..." />

                    <span class="clear-icon" id="clearSearchIcon" style="display:none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </span>
                </div>

                <div class="status-filter">
                    <select id="statusSelect" class="status-select">
                        <option value="">Status: All</option>
                        <option value="true" <%=isActive==='true' ? 'selected' : '' %>>Active</option>
                        <option value="false" <%=isActive==='false' ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>
            </div>

            <div class="banners-grid" id="bannersGrid"></div>

            <div class="pagination" id="paginationContainer"></div>
        </div>

        <!-- MODAL (Add/Edit) -->
        <div class="modal-overlay" id="bannerModal">
            <div class="modal-content large">
                <div class="modal-header">
                    <h2 class="modal-title" id="modalTitle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="#1e3a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            style="margin-right:8px;">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Banner
                    </h2>
                    <button class="modal-close" onclick="closeModal()">✕</button>
                </div>

                <p class="modal-subtitle">Configure your dynamic banner parameters.</p>

                <form id="bannerForm">
                    <input type="hidden" id="bannerId">

                    <div class="form-row">
                        <div class="form-group">
                            <label>Title <span class="required-star">*</span></label>
                            <input type="text" id="title" name="title" placeholder="Enter banner title" />
                            <span class="error-message" id="titleError"></span>
                        </div>
                        <div class="form-group">
                            <label>Subtitle <span class="required-star">*</span></label>
                            <input type="text" id="subtitle" name="subtitle" placeholder="Enter subtitle" />
                            <span class="error-message" id="subtitleError"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="width: 100%;">
                            <label>Image URL <span class="required-star">*</span></label>
                            <input type="url" id="image" name="image" placeholder="https://example.com/banner.jpg" />
                            <span class="error-message" id="imageError"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Button Text <span class="required-star">*</span></label>
                            <input type="text" id="buttonText" name="buttonText" value="Shop Now" />
                            <span class="error-message" id="buttonTextError"></span>
                        </div>
                        <div class="form-group">
                            <label>Button Link <span class="required-star">*</span></label>
                            <input type="text" id="buttonLink" name="buttonLink" placeholder="/products/target" />
                            <span class="error-message" id="buttonLinkError"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Start Date <span class="required-star">*</span></label>
                            <input type="datetime-local" id="startDate" name="startDate" />
                            <span class="error-message" id="startDateError"></span>
                        </div>
                        <div class="form-group">
                            <label>End Date <span class="required-star">*</span></label>
                            <input type="datetime-local" id="endDate" name="endDate" />
                            <span class="error-message" id="endDateError"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Display Order <span class="required-star">*</span></label>
                            <input type="number" id="order" name="order" value="0" />
                            <span class="error-message" id="orderError"></span>
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <div class="toggle-wrapper" style="margin-top: 10px;">
                                <span class="toggle-label inactive-label">Inactive</span>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="isActive" name="isActive" checked />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span class="toggle-label active-label">Active</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description <span class="required-star">*</span></label>
                        <textarea id="description" name="description" placeholder="Enter banner description"></textarea>
                        <span class="error-message" id="descriptionError"></span>
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
                        <button type="submit" class="btn-save">Save Banner</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- TOGGLE MODAL -->
        <div class="modal-overlay" id="toggleModal">
            <div class="modal-content modal-small">
                <div id="toggleModalIcon" class="delete-icon"></div>
                <h2 id="toggleModalTitle" class="delete-title"></h2>
                <p class="delete-message">
                    Are you sure you want to <strong id="toggleModalAction"></strong> this banner?
                </p>
                <input type="hidden" id="toggleBannerId" />

                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeToggleModal()">Cancel</button>
                    <button type="button" class="btn-delete" id="confirmToggleBtn"
                        onclick="confirmToggle()">Toggle</button>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="/js/admin/bannerManagement.js"></script>
</body>

</html>

<style>
    /* Ensure SweetAlert2 overlays always sit above page modals */
    .swal2-container {
        z-index: 2147483647 !important;
    }
</style>