<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="/styles/admin/reviewManagement.css">

<%- include("../partials/admin/adminSidebar") %>

    <div class="main-content">

        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title">Review Management</h1>
                <p class="page-subtitle">View and manage all customer reviews</p>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon approved">
                    <i class="bi bi-chat-square-text"></i>
                </div>
                <div class="stat-content">
                    <h3>
                        <%= stats.total || 0 %>
                    </h3>
                    <p>Total Reviews</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon average">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="stat-content">
                    <h3>
                        <%= stats.averageRating || '0.0' %>
                    </h3>
                    <p>Avg Rating</p>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-container">
            <div class="search-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input"
                    placeholder="Search by product, customer or comment..." value="<%= filters.search %>"
                    onkeypress="if(event.key === 'Enter') applyFilter('search', this.value)">
                <% if (filters.search) { %>
                    <button class="clear-search" onclick="applyFilter('search', '')" title="Clear Search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                    <% } %>
            </div>

            <select class="filter-select" onchange="applyFilter('rating', this.value)">
                <option value="">Rating: All</option>
                <option value="5" <%=filters.rating==='5' ? 'selected' : '' %>>5 Stars</option>
                <option value="4" <%=filters.rating==='4' ? 'selected' : '' %>>4 Stars</option>
                <option value="3" <%=filters.rating==='3' ? 'selected' : '' %>>3 Stars</option>
                <option value="2" <%=filters.rating==='2' ? 'selected' : '' %>>2 Stars</option>
                <option value="1" <%=filters.rating==='1' ? 'selected' : '' %>>1 Star</option>
            </select>

            <% if (filters.search || filters.rating) { %>
                <a href="/admin/reviews" class="btn-reset">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
                <% } %>
        </div>

        <!-- Reviews Table -->
        <div class="table-card">
            <table class="reviews-table">
                <thead>
                    <tr>
                        <th width="5%">#</th>
                        <th width="25%">Product</th>
                        <th width="20%">Customer</th>
                        <th width="10%">Rating</th>
                        <th width="30%">Comment</th>
                        <th width="10%" style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (reviews && reviews.length> 0) { %>
                        <% reviews.forEach(function(review, index) { %>
                            <tr>
                                <td>
                                    <%= (pagination.current - 1) * 10 + index + 1 %>
                                </td>
                                <td>
                                    <div class="product-cell">
                                        <img src="<%= review.variantImage || '/images/placeholder.png' %>"
                                            alt="<%= review.product ? review.product.productName : 'N/A' %>"
                                            class="product-thumb">
                                        <div>
                                            <span class="product-name">
                                                <%= review.product ? review.product.productName : 'Product Unavailable'
                                                    %>
                                            </span>
                                            <span class="review-date">
                                                <%= new Date(review.createdAt).toLocaleDateString('en-IN', {
                                                    day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="user-info">
                                        <span class="user-name">
                                            <%= review.user ? review.user.name : 'Unknown' %>
                                        </span>
                                        <span class="user-email">
                                            <%= review.user ? review.user.email : '' %>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="stars-cell">
                                        <% for (let s=1; s <=5; s++) { %>
                                            <i class="bi bi-star-fill"
                                                style="color:<%= s <= review.rating ? '#f59e0b' : '#e5e7eb' %>;font-size:13px;"></i>
                                            <% } %>
                                                <span class="rating-num">
                                                    <%= review.rating %>.0
                                                </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="comment-text">
                                        <%= review.comment || '—' %>
                                    </span>
                                </td>
                                <td style="text-align:right;">
                                    <div class="action-btns">
                                        <button class="action-btn view" onclick="viewReview('<%= review._id %>')"
                                            title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="action-btn delete"
                                            onclick="deleteReview('<%= review._id %>')" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6">
                                            <div class="no-results">
                                                <i class="bi bi-star" style="font-size: 2rem;"></i>
                                                <h3>No reviews found</h3>
                                                <p>Try adjusting your search or filters.</p>
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (pagination.pages> 1) { %>
            <div class="pagination">
                <% if (pagination.current> 1) { %>
                    <a href="javascript:void(0)" onclick="applyFilter('page', '<%= pagination.current - 1 %>')"
                        class="page-btn">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <% } %>
                        <% for (let i=1; i <=pagination.pages; i++) { %>
                            <a href="javascript:void(0)" onclick="applyFilter('page', '<%= i %>')"
                                class="page-btn <%= pagination.current === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                            <% } %>
                                <% if (pagination.current < pagination.pages) { %>
                                    <a href="javascript:void(0)"
                                        onclick="applyFilter('page', '<%= pagination.current + 1 %>')" class="page-btn">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                    <% } %>
            </div>
            <% } %>

    </div>

    <!-- View Review Modal -->
    <div class="review-modal-overlay" id="reviewModal">
        <div class="review-modal">
            <div class="review-modal-header">
                <h3>Review Details</h3>
                <button class="close-modal" onclick="closeModal()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="review-modal-body" id="modalBody">
                <!-- Loaded dynamically -->
            </div>
        </div>
    </div>

    <script src="/js/admin/reviewManagement.js"></script>