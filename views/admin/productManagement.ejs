<link rel="stylesheet" href="/styles/admin/productManagement.css" />
<%- include("../partials/admin/adminSidebar") %>

<div class="main-content" id="productPageRoot">
  <!-- HEADER -->
  <div class="header">
    <div class="header-left">
      <h1 class="page-title">Product Management</h1>
      <p class="page-subtitle">Manage all products, pricing, stock and listing status.</p>
    </div>

    <a href="/admin/product/add" class="add-product-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Add Product
    </a>
  </div>

  <!-- SEARCH + FILTERS -->
  <form id="productFilterForm" method="GET" action="/admin/products">
    <div class="search-container">
      <!-- Search -->
      <div class="search-wrapper">
        <span class="search-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
               viewBox="0 0 24 24" fill="none" stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>

        <input
          type="text"
          id="searchInput"
          name="search"
          class="search-input"
          value="<%= search || '' %>"
          placeholder="Search by product name..."
        />

        <span class="clear-icon" id="clearSearchIcon" style="<%= (search && search.length) ? '' : 'display:none;' %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
               viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </span>
      </div>

      <!-- Brand Filter -->
      <div class="status-filter">
        <select id="brandSelect" name="brand" class="status-select">
          <option value="">Brand: All</option>
          <option value="Sony" <%= brand === 'Sony' ? 'selected' : '' %>>Sony</option>
          <option value="Bose" <%= brand === 'Bose' ? 'selected' : '' %>>Bose</option>
          <option value="Apple" <%= brand === 'Apple' ? 'selected' : '' %>>Apple</option>
          <option value="Samsung" <%= brand === 'Samsung' ? 'selected' : '' %>>Samsung</option>
          <option value="JBL" <%= brand === 'JBL' ? 'selected' : '' %>>JBL</option>
        </select>
      </div>

      <!-- Category Filter -->
      <div class="status-filter">
        <select id="categorySelect" name="category" class="status-select">
          <option value="">Category: All</option>
          <option value="Headphones" <%= category === 'Headphones' ? 'selected' : '' %>>Headphones</option>
          <option value="Earbuds" <%= category === 'Earbuds' ? 'selected' : '' %>>Earbuds</option>
          <option value="Speakers" <%= category === 'Speakers' ? 'selected' : '' %>>Speakers</option>
          <option value="Soundbars" <%= category === 'Soundbars' ? 'selected' : '' %>>Soundbars</option>
        </select>
      </div>

      <!-- Status Filter -->
      <div class="status-filter">
        <select id="statusSelect" name="status" class="status-select">
          <option value="">Status: All</option>
          <option value="Available" <%= status === 'Available' ? 'selected' : '' %>>Available</option>
          <option value="out of stock" <%= status === 'out of stock' ? 'selected' : '' %>>Out of stock</option>
          <option value="Discontinued" <%= status === 'Discontinued' ? 'selected' : '' %>>Discontinued</option>
        </select>
      </div>

      <!-- Sort Filter -->
      <div class="status-filter">
        <select id="sortBySelect" name="sortBy" class="status-select">
          <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Sort: Newest</option>
          <option value="price-high" <%= sortBy === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="price-low" <%= sortBy === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="stock-high" <%= sortBy === 'stock-high' ? 'selected' : '' %>>Stock: High to Low</option>
          <option value="name-az" <%= sortBy === 'name-az' ? 'selected' : '' %>>Name: A-Z</option>
        </select>
      </div>
    </div>
  </form>

  <!-- TABLE -->
  <div class="table-container">
    <table class="products-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Product Name</th>
          <th>Category</th>
          <th>Brand</th>
          <th>Base Price</th>
          <th>Selling Price</th>
          <th>Stock</th>
          <th>Variants</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length) { %>
          <% products.forEach((product, index) => { %>
            <tr class="table-row-hover">
              <!-- Image -->
              <td>
                <img
                  src="<%= product.product_img && product.product_img.length ? product.product_img[0] : '/images/placeholder.jpg' %>"
                  alt="<%= product.productName %>"
                  class="product-img"
                />
              </td>

              <!-- Product Name -->
              <td>
                <div class="product-name-cell">
                  <div class="product-name-text"><%= product.productName %></div>
                  <div class="product-subtext">
                    <%= product.isLatest ? 'Latest · ' : '' %>
                    <%= product.isBestSeller ? 'Best Seller' : '' %>
                  </div>
                </div>
              </td>

              <!-- Category -->
              <td>
                <span class="cell-text">
                  <%= product.category_id ? product.category_id.categoryName : "N/A" %>
                </span>
              </td>

              <!-- Brand -->
              <td>
                <span class="cell-text">
                  <%= product.brand_id ? product.brand_id.brandName : "N/A" %>
                </span>
              </td>

              <!-- Base Price -->
              <td>
                <span class="cell-text price-base">
                  $<%= product.regularPrice ? Number(product.regularPrice).toFixed(2) : "0.00" %>
                </span>
              </td>

              <!-- Selling Price -->
              <td>
                <span class="cell-text price-sale">
                  $<%= product.salePrice 
                      ? Number(product.salePrice).toFixed(2) 
                      : product.regularPrice 
                        ? Number(product.regularPrice).toFixed(2)
                        : "0.00" 
                    %>
                </span>
              </td>

              <!-- Stock -->
              <td>
                <span class="cell-text <%= product.stock < 10 ? 'stock-low' : 'stock-ok' %>">
                  <%= product.stock %>
                </span>
              </td>

              <!-- Variants -->
              <td>
                <span class="cell-text">
                  <%= product.variants ? "Yes" : "No" %>
                </span>
              </td>

              <!-- Actions -->
              <td>
                <div class="action-btns">
                  <!-- Status Toggle -->
                  <label class="toggle-switch" title="Toggle Product Status">
                    <input 
                      type="checkbox"
                      <%= product.status === 'Available' ? 'checked' : '' %>
                      onchange="toggleProductStatus('<%= product._id %>', this.checked)"
                    />
                    <span class="toggle-slider"></span>
                  </label>

                  <!-- Edit -->
                  <button class="action-btn" onclick="window.location.href='/admin/product/<%= product._id %>'" title="Edit Product">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5l4 4L7 21H3v-4z"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="9" class="empty-state">
              No products found. Try adjusting filters or add a new product.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- PAGINATION + INFO -->
  <div class="pagination-wrapper">
    <div class="pagination-info">
      <% if (totalProducts && totalProducts > 0) { %>
        Showing <%= startIndex %> - <%= endIndex %> of <%= totalProducts %> products
      <% } %>
    </div>

    <div class="pagination">
      <!-- Prev -->
      <a
        href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&status=<%= status || '' %>&sortBy=<%= sortBy || '' %>"
        class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>"
        <%= currentPage === 1 ? 'onclick="return false;"' : '' %>>
        Prev
      </a>

      <!-- Page Numbers -->
      <% for(let i = 1; i <= totalPages; i++) { %>
        <a
          href="?page=<%= i %>&search=<%= search || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&status=<%= status || '' %>&sortBy=<%= sortBy || '' %>"
          class="page-btn <%= currentPage === i ? 'active' : '' %>">
          <%= i %>
        </a>
      <% } %>

      <!-- Next -->
      <a
        href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&brand=<%= brand || '' %>&category=<%= category || '' %>&status=<%= status || '' %>&sortBy=<%= sortBy || '' %>"
        class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>"
        <%= currentPage === totalPages ? 'onclick="return false;"' : '' %>>
        Next
      </a>
    </div>
  </div>
</div>

<!-- STATUS TOGGLE SCRIPT -->
<script>
function toggleProductStatus(productId, isActive) {
  fetch(`/admin/product/${productId}/status`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ status: isActive ? "Available" : "Discontinued" })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      alert("Status updated");
    }
  })
  .catch(err => console.error(err));
}

// Clear search icon behaviour
const searchInput = document.getElementById('searchInput');
const clearIcon = document.getElementById('clearSearchIcon');

if (searchInput && clearIcon) {
  searchInput.addEventListener('input', () => {
    if (searchInput.value.trim().length > 0) {
      clearIcon.style.display = 'block';
    } else {
      clearIcon.style.display = 'none';
    }
  });

  clearIcon.addEventListener('click', () => {
    searchInput.value = '';
    clearIcon.style.display = 'none';
    document.getElementById('productFilterForm').submit();
  });
}
</script>
