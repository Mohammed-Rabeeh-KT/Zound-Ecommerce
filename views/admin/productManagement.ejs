<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<%- include('../partials/admin/adminSidebar') %>
<link rel="stylesheet" href="/styles/admin/productmanagement.css">

        <div class="main-content">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Products</h1>
                    <p class="page-subtitle">Manage your product catalog and inventory</p>
                </div>
                <button class="btn-primary" onclick="openModal('add')">
                    <i class="bi bi-plus-lg"></i> Add New Product
                </button>
            </div>

            <!-- Search & Filters -->
            <div class="search-container">
                <div class="search-wrapper">
                    <span class="search-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" class="search-input" placeholder="Search products..." value="<%= filters.search || '' %>" 
                        onkeypress="if(event.key === 'Enter') applyFilter('search', this.value)">
                    
                    <% if(filters.search) { %>
                    <span class="clear-icon" onclick="applyFilter('search', '')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </span>
                    <% } %>
                </div>

                <select class="filter-select" style="width: 180px;" onchange="applyFilter('category', this.value)">
                    <option value="">Category: All</option>
                    <% categories.forEach(cat=> { %>
                        <option value="<%= cat._id %>" <%=filters.category==cat._id ? 'selected' : '' %>><%= cat.name %>
                        </option>
                    <% }) %>
                </select>

                <select class="filter-select" style="width: 150px;" onchange="applyFilter('brand', this.value)">
                    <option value="">Brand: All</option>
                    <% brands.forEach(b => { %>
                        <option value="<%= b._id %>" <%=filters.brand==b._id ? 'selected' : '' %>><%= b.brandName %>
                        </option>
                    <% }) %>
                </select>

                <select class="filter-select" style="width: 150px;" onchange="applyFilter('status', this.value)">
                    <option value="">Status: All</option>
                    <option value="active" <%=filters.status=='active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%=filters.status=='inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
            </div>

            <div class="table-card">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th width="50">#</th>
                            <th>Product Details</th>
                            <th>Category</th> <!-- New Column -->
                            <th>Brand</th>
                            <th>Variants</th>
                            <th>Total Stock</th>
                            <th>Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(products.length> 0) { %>
                            <% products.forEach((p, idx)=> { %>
                                <tr>
                                    <td>
                                        <%= (currentPageNum - 1) * 10 + idx + 1 %>
                                    </td>
                                    <td>
                                        <div class="product-info">
                                            <% let thumb=p.productImages && p.productImages.length> 0 ?
                                                p.productImages[0] : '/images/default.jpg';
                                                if(p.variants && p.variants.length > 0) {
                                                const sorted = [...p.variants].sort((a,b) => (a.salePrice || 0) -
                                                (b.salePrice || 0));
                                                const minVar = sorted[0];
                                                if(minVar && minVar.images && minVar.images.length > 0) {
                                                thumb = minVar.images[0];
                                                } else if (minVar && minVar.image) {
                                                thumb = minVar.image;
                                                }
                                                }
                                                %>
                                                <img src="<%= thumb %>" class="product-thumb">
                                                <div>
                                                    <span class="product-name truncate">
                                                        <%= p.productName %>
                                                    </span>
                                                </div>
                                        </div>
                                    </td>
                                    <td>
                                        <%= p.category?.name || 'Uncategorized' %>
                                    </td>
                                    <td>
                                        <%= p.brand?.brandName || 'N/A' %>
                                    </td>
                                    <td>
                                        <% if(p.variants && p.variants.length> 0) { %>
                                            <span class="badge"
                                                style="background:#f1f5f9; padding:4px 8px; border-radius:4px; font-size:11px;">
                                                <%= p.variants.length %> variants
                                            </span>
                                            <% } else { %>
                                                <span style="color:var(--text-light); font-size:12px;">No
                                                    variants</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <%= (p.variants || []).reduce((sum, v)=> sum + (v.stock || 0), 0) %>
                                    </td>
                                    <td>
                                        <span class="status-badge status-<%= p.status %>">
                                            <%= p.status %>
                                        </span>
                                    </td>
                                    <td align="right">
                                        <a href="/admin/products/<%= p._id %>/details" class="action-btn"
                                            title="View Details"
                                            style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button class="action-btn"
                                            onclick="toggleProduct('<%= p._id %>', '<%= p.status %>')"
                                            title="<%= p.status === 'Active' ? 'Unlist Product' : 'List Product' %>">
                                            <% if(p.status==='Active' ) { %>
                                                <!-- Unlist Icon (Red) -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                    viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"
                                                    stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="9"></circle>
                                                    <line x1="5" y1="5" x2="19" y2="19"></line>
                                                </svg>
                                                <% } else { %>
                                                    <!-- List Icon (Green) -->
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="#1dbf4f"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="9"></circle>
                                                        <path d="M9 12l2 2 4-4"></path>
                                                    </svg>
                                                    <% } %>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" align="center" style="padding:40px;">No products found</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>

            </div>

            <!-- Pagination -->
            <% if(totalPages > 1) { %>
            <div class="pagination">
                <% if(currentPageNum > 1) { %>
                    <a href="javascript:void(0)" onclick="applyFilter('page', '<%= currentPageNum - 1 %>')" class="page-btn">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                <% } %>

                <% for(let i = 1; i <= totalPages; i++) { %>
                    <% if (i === 1 || i === totalPages || (i >= currentPageNum - 1 && i <= currentPageNum + 1)) { %>
                        <a href="javascript:void(0)" onclick="applyFilter('page', '<%= i %>')" class="page-btn <%= currentPageNum == i ? 'active' : '' %>">
                            <%= i %>
                        </a>
                    <% } else if (i === currentPageNum - 2 || i === currentPageNum + 2) { %>
                        <span class="page-btn" style="border:none; background:transparent;">...</span>
                    <% } %>
                <% } %>

                <% if(currentPageNum < totalPages) { %>
                    <a href="javascript:void(0)" onclick="applyFilter('page', '<%= currentPageNum + 1 %>')" class="page-btn">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                <% } %>
            </div>
            <% } %>
        </div>

        <!-- ADD/EDIT MODAL -->
        <%- include('../partials/admin/productModals') %>

            <!-- Include JS logic -->
<script src="/js/admin/productManagement.js"></script>