<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Brands Management</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
  <link rel="stylesheet" href="/styles/admin/brandManagement.css" />
</head>

<body>
  <%- include("../partials/admin/adminSidebar") %>

    <div class="main-content">
      <div class="header">
        <div class="header-left">
          <h1 class="page-title">Brands Management</h1>
          <p class="page-subtitle">Manage mobile brands and logos.</p>
        </div>

        <button class="add-brand-btn" id="addBrandBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Brand
        </button>
      </div>

      <div class="search-container">
        <div class="search-wrapper">
          <span class="search-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>

          <input type="text" id="searchInput" class="search-input" value="<%= search || '' %>"
            placeholder="Search brands..." />

          <span class="clear-icon" id="clearSearchIcon" style="display:none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </span>
        </div>

        <div class="status-filter">
          <select id="statusSelect" class="status-select">
            <option value="">Status: All</option>
            <option value="listed" <%=status==='listed' ? 'selected' : '' %>>Listed</option>
            <option value="unlisted" <%=status==='unlisted' ? 'selected' : '' %>>Unlisted</option>
          </select>
        </div>
      </div>

      <div class="table-container">
        <table class="brands-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Logo</th>
              <th>Brand Name</th>
              <th class="text-center">Products</th>
              <th>Status</th>
              <th>Created At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="brandsTableBody"></tbody>
        </table>
      </div>

      <div class="pagination" id="paginationContainer"></div>
    </div>

    <div class="modal-overlay" id="addBrandModal">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#1e3a5f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="margin-right:8px;">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add New Brand
          </h2>
          <button class="modal-close" data-close="addBrandModal">✕</button>
        </div>

        <p class="modal-subtitle">Create a new brand entry.</p>

        <form id="addBrandForm" enctype="multipart/form-data">
          <div class="form-group">
            <label>Brand Name <span class="required">*</span></label>
            <input type="text" name="brandName" placeholder="e.g., Apple" required />
          </div>

          <div class="form-group">
            <label>Brand Logo <span class="required">*</span></label>

            <div class="drop-zone" id="addBrandDropZone">
              <span class="drop-zone-prompt">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none"
                  stroke="#6c6c6c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <br>
                Drag & drop or click to upload
              </span>
              <input type="file" name="logo" class="drop-zone-input" accept="image/*" required id="addBrandFile" />
              <div class="drop-zone-thumb" style="display:none;"></div>
            </div>
          </div>

          <div class="form-group">
            <label>Status</label>
            <div class="toggle-wrapper">
              <span class="toggle-label inactive-label">Unlisted</span>
              <label class="toggle-switch">
                <input type="checkbox" name="isListed" checked />
                <span class="toggle-slider"></span>
              </label>
              <span class="toggle-label active-label">Listed</span>
            </div>
          </div>

          <div class="modal-actions">
            <button type="button" class="btn-cancel" data-close="addBrandModal">Cancel</button>
            <button type="submit" class="btn-save">Add Brand</button>
          </div>
        </form>
      </div>
    </div>

    <div class="modal-overlay" id="cropperModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">Crop Image</h2>
        <button class="modal-close" data-close="cropperModal">✕</button>
      </div>
      
      <div class="crop-container" style="height: 400px; width: 100%; overflow: hidden;">
        <img id="imageToCrop" style="max-width: 100%; display: block;">
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-cancel" data-close="cropperModal">Cancel</button>
        <button type="button" class="btn-save" id="cropImageBtn">Crop & Save</button>
      </div>
    </div>
  </div>

    <div class="modal-overlay" id="editBrandModal">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title">Edit Brand</h2>
          <button class="modal-close" data-close="editBrandModal">✕</button>
        </div>

        <form id="editBrandForm" enctype="multipart/form-data">
          <input type="hidden" id="editBrandId" name="id" />

          <div class="form-group">
            <label>Brand Name <span class="required">*</span></label>
            <input type="text" id="editBrandName" name="brandName" required />
          </div>

          <div class="form-group">
            <label>Brand Logo</label>
            <div class="drop-zone" id="editBrandDropZone">
              <span class="drop-zone-prompt">Change Logo</span>
              <input type="file" name="logo" class="drop-zone-input" accept="image/*" id="editBrandFile" />
              <div class="drop-zone-thumb" id="editBrandThumb"></div>
            </div>
          </div>

          <div class="form-group">
            <label>Status</label>
            <div class="toggle-wrapper">
              <span class="toggle-label inactive-label">Unlisted</span>
              <label class="toggle-switch">
                <input type="checkbox" id="editBrandStatus" name="isListed" />
                <span class="toggle-slider"></span>
              </label>
              <span class="toggle-label active-label">Listed</span>
            </div>
          </div>

          <div class="modal-actions">
            <button type="button" class="btn-cancel" data-close="editBrandModal">Cancel</button>
            <button type="submit" class="btn-save">Update Brand</button>
          </div>
        </form>
      </div>
    </div>


    <div class="modal-overlay" id="toggleModal">
      <div class="modal-content modal-small">
        <div id="toggleModalIcon" class="delete-icon"></div>
        <h2 id="toggleModalTitle" class="delete-title"></h2>
        <p class="delete-message">
          Are you sure you want to <strong id="toggleModalAction"></strong>
          <strong id="toggleBrandName"></strong>?
        </p>
        <input type="hidden" id="toggleBrandId" />

        <div class="modal-actions">
          <button type="button" class="btn-cancel" data-close="toggleModal">Cancel</button>
          <button type="button" class="btn-delete" id="confirmToggleBtn"></button>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script type="module" src="/js/admin/brandManagement.js"></script>
</body>

</html>