<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Product Details | ZOUND Premium</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/styles/admin/productdetails.css">
</head>

<body>
    <%- include('../partials/admin/adminSidebar') %>

        <div class="main-content">
            <div class="detail-header">
                <a href="/admin/products" class="back-btn"><i class="bi bi-arrow-left"></i></a>
                <div>
                    <span style="color:var(--text-light);">Product Details:</span>
                    <strong style="color:var(--secondary); margin-left: 5px;">
                        <%= product.productName %>
                    </strong>
                </div>
            </div>

            <div class="detail-card">

                <div class="product-title-row">
                    <div>
                        <h1 class="p-title">
                            <%= product.productName %>
                                <span class="p-badget"
                                    style="<%= product.status === 'Inactive' ? 'background:#fee2e2; color:#991b1b;' : '' %>">
                                    <%= product.status %>
                                </span>
                        </h1>
                        <div style="display:flex; gap: 20px; margin-top: 15px;">
                            <div>
                                <div class="info-label">Brand</div>
                                <div class="info-value">
                                    <%= product.brand?.brandName || (typeof product.brand==='string' ? product.brand
                                        : 'N/A' ) %>
                                </div>
                            </div>
                            <div style="border-left: 1px solid #e2e8f0; padding-left: 20px;">
                                <div class="info-label">Category</div>
                                <div class="info-value">
                                    <%= product.category?.name || 'N/A' %>
                                </div>
                            </div>
                            <div style="border-left: 1px solid #e2e8f0; padding-left: 20px;">
                                <div class="info-label">Base Price Range</div>
                                <div class="info-value">
                                    <% if(product.variants && product.variants.length> 0) {
                                        const prices = product.variants.map(v => v.salePrice);
                                        const min = Math.min(...prices);
                                        const max = Math.max(...prices);
                                        %>
                                        ₹<%= min %> - ₹<%= max %>
                                                <% } else { %>
                                                    N/A
                                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Redirects to Management Page and Triggers Edit Modal -->
                    <!-- Trigger Edit Modal directly -->
                    <button class="edit-btn" onclick="editProduct('<%= product._id %>')">
                        <i class="bi bi-pencil-square"></i> Edit Product Details
                    </button>
                </div>

                <div class="content-grid">
                    <!-- Left Column -->
                    <div>
                        <div class="stat-box"
                            style="text-align:left; background: white; padding:0; margin-bottom: 30px;">
                            <h3 class="section-title">Product Description</h3>
                            <p
                                style="color: var(--text-light); line-height: 1.7; margin-top: 10px; max-width: 65%; word-break: break-word;">
                                <%= product.description %>
                            </p>
                        </div>

                        <h3 class="section-title">Key Features</h3>
                        <ul class="feature-list" style="max-width: 65%;">
                            <% if(product.features && product.features.length> 0) { %>
                                <% product.features.forEach(f=> { %>
                                    <li>
                                        <%= f %>
                                    </li>
                                    <% }) %>
                                        <% } else { %>
                                            <li>No specific features listed.</li>
                                            <% } %>
                        </ul>
                    </div>

                    <!-- Right Column Stats -->
                    <div>
                        <div class="stat-box">
                            <span class="info-label">Total Stock</span>
                            <span class="stat-big">
                                <%= product.variants ? product.variants.reduce((sum, v)=> sum + v.stock, 0) : 0 %>
                            </span>
                        </div>

                        <div class="stat-box" style="background:#eff6ff;">
                            <span class="info-label" style="color: var(--secondary);">Active Variants</span>
                            <span class="stat-big" style="font-size: 28px;">
                                <%= product.variants ? product.variants.length : 0 %>
                            </span>
                        </div>

                        <div class="stat-box" style="background:#dcfce7;">
                            <span class="info-label" style="color: #166534;">Rating</span>
                            <span class="stat-big" style="font-size: 28px; color: #166534;">
                                4.8 <i class="bi bi-star-fill" style="font-size: 20px;"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="inventory-section">
                    <h3 class="section-title">Inventory Breakdown</h3>
                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th>Variant Type</th>
                                <th>Value</th>
                                <th>Base Price</th>
                                <th>Selling Price</th>
                                <th>Images</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th style="text-align: center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(product.variants && product.variants.length> 0) { %>
                                <% product.variants.forEach((v, idx)=> { %>
                                    <tr>
                                        <td>
                                            <%= v.type %>
                                        </td>
                                        <td>
                                            <div style="display:flex; align-items:center;">
                                                <% if(v.colorCode) { %>
                                                    <span class="variant-dot"
                                                        style="background: <%= v.colorCode %>;"></span>
                                                    <% } %>
                                                        <strong>
                                                            <%= v.value %>
                                                        </strong>
                                            </div>
                                        </td>
                                        <td>₹<%= v.basePrice %>
                                        </td>
                                        <td>₹<%= v.salePrice %>
                                        </td>
                                        <td>
                                            <span class="badget" style="background:#e0f2fe; color:#0369a1;">
                                                <i class="bi bi-images"></i>
                                                <%= v.images ? v.images.length : (v.image ? 1 : 0) %>
                                            </span>
                                        </td>
                                        <td>
                                            <span
                                                style="<%= v.stock < 10 ? 'color: #ef4444; font-weight:bold;' : '' %>">
                                                <%= v.stock %> units
                                            </span>
                                        </td>
                                        <td>
                                            <span id="v-status-<%= v._id %>"
                                                class="status-badge status-<%= v.status %>">
                                                <%= v.status %>
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <button onclick="editVariantFromDetails('<%= product._id %>', <%= idx %>)"
                                                style="border:none; background:transparent; color: var(--secondary); cursor:pointer;"
                                                title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button
                                                onclick="toggleVariantStatus('<%= product._id %>', '<%= v._id %>', '<%= v.status %>')"
                                                style="border:none; background:transparent; cursor:pointer; margin-left:10px;"
                                                title="<%= v.status === 'Active' ? 'Unlist Variant' : 'List Variant' %>">
                                                <% if(v.status==='Active' ) { %>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                        viewBox="0 0 24 24" fill="none" stroke="#ef4444"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="9"></circle>
                                                        <line x1="5" y1="5" x2="19" y2="19"></line>
                                                    </svg>
                                                    <% } else { %>
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                            viewBox="0 0 24 24" fill="none" stroke="#1dbf4f"
                                                            stroke-width="2" stroke-linecap="round"
                                                            stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="9"></circle>
                                                            <path d="M9 12l2 2 4-4"></path>
                                                        </svg>
                                                        <% } %>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="7">No variants found</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>

                <div class="inventory-section">
                    <h3 class="section-title">Product Images</h3>
                    <h4 style="font-size:16px; margin:20px 0 10px; color:var(--secondary);">Common Images</h4>
                    <div class="gallery-grid">
                        <% if(product.productImages && product.productImages.length> 0) { %>
                            <% product.productImages.forEach(img=> { %>
                                <div class="gallery-item">
                                    <img src="<%= img %>" class="gallery-img">
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p style="color:var(--text-light); font-size:13px;">No common images</p>
                                        <% } %>
                    </div>

                    <% if(product.variants && product.variants.length> 0) { %>
                        <% product.variants.forEach(v=> { %>
                            <% if((v.images && v.images.length> 0) || v.image) { %>
                                <h4
                                    style="font-size:16px; margin:30px 0 10px; color:var(--text-dark); border-top:1px solid #eee; padding-top:20px;">
                                    Variant: <%= v.value %> (<%= v.type %>)
                                </h4>
                                <div class="gallery-grid">
                                    <% if(v.images && v.images.length> 0) { %>
                                        <% v.images.forEach(img=> { %>
                                            <div class="gallery-item">
                                                <img src="<%= img %>" class="gallery-img">
                                            </div>
                                            <% }) %>
                                                <% } else if(v.image) { %>
                                                    <div class="gallery-item">
                                                        <img src="<%= v.image %>" class="gallery-img">
                                                    </div>
                                                    <% } %>
                                </div>
                                <% } %>
                                    <% }) %>
                                        <% } %>
                </div>

            </div>
        </div>

        <%- include('../partials/admin/productModals') %>

            <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
            <script src="/js/admin/productManagement.js"></script>
</body>

</html>