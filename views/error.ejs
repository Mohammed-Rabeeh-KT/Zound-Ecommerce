<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="max-w-md w-full bg-white shadow-lg rounded-lg p-8 text-center">
        <div class="mb-4">
            <svg class="h-16 w-16 text-red-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
            <%= statusCode %>
        </h1>
        <h2 class="text-xl font-semibold text-gray-600 mb-4">
            <%= message %>
        </h2>

        <p class="text-gray-500 mb-6">Oops! Something went wrong.</p>

        <a href="/user/login"
            class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded transition duration-200">
            Go to login 
        </a>

        <% if (error && error.stack) { %>
            <div class="mt-8 text-left bg-gray-900 text-red-400 p-4 rounded overflow-auto max-h-64 text-sm">
                <pre><%= error.stack %></pre>
            </div>
            <% } %>
    </div>
</div>