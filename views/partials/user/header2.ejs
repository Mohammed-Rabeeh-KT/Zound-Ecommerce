<header
  class="w-full sticky top-0 z-50 transition-all duration-300 backdrop-blur-md bg-white/85 border-b border-gray-200/50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/user/home" class="flex items-center gap-2 group">
      <div
        class="bg-gradient-to-br from-[#002366] to-[#0a358c] text-white p-1.5 rounded-lg shadow-md group-hover:scale-105 transition-transform duration-300">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          class="transform -rotate-12">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <span
        class="font-extrabold text-2xl tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-[#002366] to-[#0a358c]">ZOUND</span>
    </a>

    <!-- Primary Nav Links -->
    <nav class="hidden lg:flex items-center gap-8 text-[15px] font-semibold text-gray-600">
      <a href="/user/products" class="relative group hover:text-[#002366] transition-colors duration-300">
        Products
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#002366] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/user/brands" class="relative group hover:text-[#002366] transition-colors duration-300">
        Brands
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#002366] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/user/deals" class="relative group hover:text-[#002366] transition-colors duration-300">
        Deals
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#002366] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href="/user/support" class="relative group hover:text-[#002366] transition-colors duration-300">
        Support
        <span
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#002366] transition-all duration-300 group-hover:w-full"></span>
      </a>
    </nav>

    <!-- Right Side Controls -->
    <div class="flex items-center gap-3 sm:gap-5">

      <!-- Search -->
      <form id="globalSearchForm" action="/user/products" method="GET"
        class="hidden md:flex items-center group relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-gray-400 group-focus-within:text-[#002366] transition-colors" fill="none"
            stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input id="searchInput" name="search"
          class="w-40 xl:w-64 pl-10 pr-4 py-2 bg-gray-100/80 border border-transparent focus:bg-white focus:border-[#002366] focus:ring-2 focus:ring-[#002366]/20 rounded-full text-sm transition-all duration-300 ease-in-out outline-none shadow-sm"
          placeholder="Search premium audio..." autocomplete="off"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
      </form>

      <% if (locals.user) { %>
        <!-- Wishlist -->
        <a href="/user/wishlist"
          class="relative p-2 rounded-full text-gray-600 hover:text-[#002366] hover:bg-[#002366]/5 transition-all duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
            </path>
          </svg>
          <% if (typeof wishlistCount !=='undefined' && wishlistCount> 0) { %>
            <span
              class="absolute top-1 right-0.5 flex items-center justify-center w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full border-2 border-white shadow-sm transform scale-110">
              <%= wishlistCount %>
            </span>
            <% } %>
        </a>

        <!-- Cart -->
        <a href="/user/cart"
          class="relative p-2 rounded-full text-gray-600 hover:text-[#002366] hover:bg-[#002366]/5 transition-all duration-300 mr-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
            <span
              class="absolute top-1 right-0.5 flex items-center justify-center w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full border-2 border-white shadow-sm transform scale-110">
              <%= cartCount %>
            </span>
            <% } %>
        </a>

        <!-- USER AVATAR -->
        <div class="relative">
          <button id="avatarBtn"
            class="flex items-center focus:outline-none focus:ring-2 focus:ring-[#002366] focus:ring-offset-2 rounded-full transition-shadow duration-300">
            <% if (user.profile_picture) { %>
              <div class="w-10 h-10 rounded-full p-0.5 bg-gradient-to-tr from-[#002366] to-[#0a358c]">
                <img src="<%= user.profile_picture %>"
                  class="w-full h-full rounded-full object-cover border-2 border-white shadow-sm" />
              </div>
              <% } else { %>
                <div
                  class="w-10 h-10 flex items-center justify-center bg-gradient-to-tr from-[#002366] to-[#0a358c] text-white text-lg font-bold rounded-full shadow-md border-2 border-white">
                  <%= user.name.charAt(0).toUpperCase() %>
                </div>
                <% } %>
          </button>

          <!-- Dropdown Menu -->
          <div id="avatarDropdown"
            class="hidden absolute right-0 mt-3 w-56 bg-white/95 backdrop-blur-xl border border-gray-100 shadow-2xl rounded-2xl overflow-hidden z-50 transform origin-top-right transition-all opacity-0 translate-y-[-10px] duration-200">
            <div class="px-5 py-4 border-b border-gray-100/80 bg-gray-50/50">
              <p class="font-bold text-gray-900 truncate">
                <%= user.name %>
              </p>
              <p class="text-[13px] text-gray-500 truncate mt-0.5">
                <%= user.email %>
              </p>
            </div>
            <div class="py-2">
              <a href="/user/profile"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-gray-700 hover:text-[#002366] hover:bg-[#002366]/5 transition-colors">
                <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                My Profile
              </a>
              <a href="/user/wishlist"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-gray-700 hover:text-[#002366] hover:bg-[#002366]/5 transition-colors">
                <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                  </path>
                </svg>
                My Wishlist
              </a>
              <a href="/user/orders"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-gray-700 hover:text-[#002366] hover:bg-[#002366]/5 transition-colors">
                <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                My Orders
              </a>
            </div>
            <div class="border-t border-gray-100/80 py-1.5 bg-gray-50/30">
              <button type="button" onclick="Logout()"
                class="w-full flex items-center px-5 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                  </path>
                </svg>
                Logout
              </button>
            </div>
          </div>
        </div>

        <% } else { %>
          <!-- Guest view -->
          <a href="/user/cart"
            class="relative p-2 rounded-full text-gray-600 hover:text-[#002366] hover:bg-[#002366]/5 transition-all duration-300 mr-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
              <span
                class="absolute top-1 right-0.5 flex items-center justify-center w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full border-2 border-white shadow-sm transform scale-110">
                <%= cartCount %>
              </span>
              <% } %>
          </a>

          <a href="/user/login"
            class="px-6 py-2.5 text-sm font-bold rounded-full bg-gradient-to-r from-[#002366] to-[#0a358c] text-white hover:from-[#001a4d] hover:to-[#002366] shadow-[0_4px_14px_0_rgba(0,35,102,0.39)] hover:shadow-[0_6px_20px_rgba(0,35,102,0.23)] hover:-translate-y-0.5 transition-all duration-300">
            Sign In
          </a>
          <% } %>

    </div>
  </div>
</header>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  // Avatar Dropdown Toggle with sleek fade-in
  const avatarBtn = document.getElementById("avatarBtn");
  const avatarDropdown = document.getElementById("avatarDropdown");

  if (avatarBtn) {
    avatarBtn.addEventListener("click", (e) => {
      e.stopPropagation(); // prevent window click
      const isHidden = avatarDropdown.classList.contains("hidden");

      if (isHidden) {
        avatarDropdown.classList.remove("hidden");
        // small delay to allow display:block to apply before opacity transition
        setTimeout(() => {
          avatarDropdown.classList.remove("opacity-0", "translate-y-[-10px]");
          avatarDropdown.classList.add("opacity-100", "translate-y-0");
        }, 10);
      } else {
        closeDropdown();
      }
    });

    const closeDropdown = () => {
      avatarDropdown.classList.remove("opacity-100", "translate-y-0");
      avatarDropdown.classList.add("opacity-0", "translate-y-[-10px]");
      setTimeout(() => {
        avatarDropdown.classList.add("hidden");
      }, 200); // match duration
    };

    window.addEventListener("click", (e) => {
      if (!avatarDropdown.classList.contains("hidden") && !avatarDropdown.contains(e.target) && !avatarBtn.contains(e.target)) {
        closeDropdown();
      }
    });
  }

  function Logout() {
    Swal.fire({
      title: "Sign Out",
      text: "Are you sure you want to end your session?",
      icon: "question",
      showCancelButton: true,
      confirmButtonColor: "#002366", // royal blue
      cancelButtonColor: "#f3f4f6", // gray-100
      confirmButtonText: "Yes, Sign out",
      cancelButtonText: "<span style='color: #374151'>Cancel</span>",
      customClass: {
        confirmButton: 'rounded-lg font-semibold',
        cancelButton: 'rounded-lg border border-gray-300'
      }
    }).then((result) => {
      if (result.isConfirmed) {
        if (typeof window.toast !== 'undefined') { window.toast.success("Successfully logged out."); } else { Swal.fire({ title: "Signed Out", text: "See you next time!", icon: "success", timer: 1500, showConfirmButton: false }); } setTimeout(() => { window.location.href = '/user/logout'; }, 1200); //
          .then(() => {
            Swal.fire({
              title: "Signed Out",
              text: "See you next time!",
              icon: "success",
              timer: 1500,
              showConfirmButton: false
            });
            setTimeout(() => {
              window.location.href = '/user/login';
            }, 1200);
          })
          .catch(error => {
            console.error("Logout error:", error);
            if (typeof window.toast !== 'undefined') window.toast.error("Logout failed. Try again!");
            else Swal.fire("Error", "Something went wrong. Try again!", "error");
          });
      }
    });
  }
</script>