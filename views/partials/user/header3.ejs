<header class="w-full bg-[#0a0a0a] border-b border-neutral-800 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div
        class="bg-neutral-800 text-teal-400 p-1.5 rounded-none group-hover:bg-neutral-700 transition-colors duration-300 border border-neutral-700">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <span class="font-black text-2xl tracking-widest text-white uppercase">
        ZOUND<span class="text-teal-400">.</span>
      </span>
    </a>

    <!-- Primary Nav Links -->
    <nav class="hidden lg:flex items-center gap-8 text-[13px] font-bold tracking-widest text-neutral-400 uppercase">
      <a href="/user/products" class="hover:text-teal-400 transition-colors duration-300">Products</a>
      <a href="/brands" class="hover:text-teal-400 transition-colors duration-300">Brands</a>
      <a href="/deals" class="hover:text-teal-400 transition-colors duration-300">Deals</a>
      <a href="/support" class="hover:text-teal-400 transition-colors duration-300">Support</a>
    </nav>

    <!-- Right Side Controls -->
    <div class="flex items-center gap-3 sm:gap-6">

      <!-- Search -->
      <form id="globalSearchForm" action="/user/products" method="GET" class="hidden md:flex items-center relative">
        <input id="searchInput" name="search"
          class="w-40 xl:w-64 pl-4 pr-10 py-2 bg-neutral-900 border border-neutral-800 focus:bg-black focus:border-teal-400 text-neutral-200 placeholder-neutral-600 rounded-none text-sm outline-none transition-all duration-300"
          placeholder="Search store..." autocomplete="off"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
        <button type="submit" class="absolute right-3 text-neutral-500 hover:text-teal-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </form>

      <% if (locals.user) { %>
        <!-- Wishlist -->
        <a href="/user/wishlist" class="relative text-neutral-400 hover:text-white transition-colors duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
            </path>
          </svg>
          <% if (typeof wishlistCount !=='undefined' && wishlistCount> 0) { %>
            <span
              class="absolute -top-2 -right-2 flex items-center justify-center w-4 h-4 bg-teal-500 text-black text-[10px] font-black rounded-none">
              <%= wishlistCount %>
            </span>
            <% } %>
        </a>

        <!-- Cart -->
        <a href="/user/cart" class="relative text-neutral-400 hover:text-white transition-colors duration-300 mr-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
            <span
              class="absolute -top-2 -right-2 flex items-center justify-center w-4 h-4 bg-teal-500 text-black text-[10px] font-black rounded-none">
              <%= cartCount %>
            </span>
            <% } %>
        </a>

        <!-- USER AVATAR -->
        <div class="relative">
          <button id="avatarBtn"
            class="flex items-center focus:outline-none focus:ring-2 focus:ring-teal-500 rounded-full transition-shadow duration-300">
            <% if (user.profile_picture) { %>
              <div class="w-10 h-10 rounded-full p-0.5 bg-neutral-800">
                <img src="<%= user.profile_picture %>"
                  class="w-full h-full rounded-full object-cover border border-neutral-700" />
              </div>
              <% } else { %>
                <div
                  class="w-10 h-10 flex items-center justify-center bg-neutral-800 text-teal-400 text-lg font-black rounded-full border border-neutral-700">
                  <%= user.name.charAt(0).toUpperCase() %>
                </div>
                <% } %>
          </button>

          <!-- Dropdown Menu -->
          <div id="avatarDropdown"
            class="hidden absolute right-0 mt-3 w-56 bg-[#111] border border-neutral-800 shadow-2xl rounded-none overflow-hidden z-50 transform origin-top-right transition-all opacity-0 translate-y-[-10px] duration-200">
            <div class="px-5 py-4 border-b border-neutral-800 bg-[#0a0a0a]">
              <p class="font-bold text-white truncate">
                <%= user.name %>
              </p>
              <p class="text-[12px] text-neutral-500 truncate mt-1">
                <%= user.email %>
              </p>
            </div>
            <div class="py-2">
              <a href="/user/profile"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-neutral-300 hover:text-teal-400 hover:bg-neutral-900 transition-colors">
                <svg class="w-4 h-4 mr-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                My Profile
              </a>
              <a href="/user/wishlist"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-neutral-300 hover:text-teal-400 hover:bg-neutral-900 transition-colors">
                <svg class="w-4 h-4 mr-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                  </path>
                </svg>
                My Wishlist
              </a>
              <a href="/user/orders"
                class="flex items-center px-5 py-2.5 text-sm font-medium text-neutral-300 hover:text-teal-400 hover:bg-neutral-900 transition-colors">
                <svg class="w-4 h-4 mr-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                My Orders
              </a>
            </div>
            <div class="border-t border-neutral-800 py-1 bg-black">
              <button type="button" onclick="Logout()"
                class="w-full flex items-center px-5 py-3 text-sm font-bold tracking-wider text-red-500 hover:bg-red-950/30 transition-colors">
                <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                  </path>
                </svg>
                LOGOUT
              </button>
            </div>
          </div>
        </div>

        <% } else { %>
          <!-- Guest view -->
          <a href="/user/cart" class="relative text-neutral-400 hover:text-white transition-colors duration-300 mr-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
              <span
                class="absolute -top-2 -right-2 flex items-center justify-center w-4 h-4 bg-teal-500 text-black text-[10px] font-black rounded-none">
                <%= cartCount %>
              </span>
              <% } %>
          </a>

          <a href="/user/login"
            class="px-6 py-2.5 text-sm font-bold tracking-wider uppercase border-2 border-teal-500 text-teal-400 hover:bg-teal-500 hover:text-black transition-all duration-300 rounded-none shadow-[0_0_15px_rgba(20,184,166,0.2)] hover:shadow-[0_0_20px_rgba(20,184,166,0.4)]">
            Sign In
          </a>
          <% } %>

    </div>
  </div>
</header>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  // Avatar Dropdown Toggle with sleek fade-in
  const avatarBtn = document.getElementById("avatarBtn");
  const avatarDropdown = document.getElementById("avatarDropdown");

  if (avatarBtn) {
    avatarBtn.addEventListener("click", (e) => {
      e.stopPropagation(); // prevent window click
      const isHidden = avatarDropdown.classList.contains("hidden");

      if (isHidden) {
        avatarDropdown.classList.remove("hidden");
        // small delay to allow display:block to apply before opacity transition
        setTimeout(() => {
          avatarDropdown.classList.remove("opacity-0", "translate-y-[-10px]");
          avatarDropdown.classList.add("opacity-100", "translate-y-0");
        }, 10);
      } else {
        closeDropdown();
      }
    });

    const closeDropdown = () => {
      avatarDropdown.classList.remove("opacity-100", "translate-y-0");
      avatarDropdown.classList.add("opacity-0", "translate-y-[-10px]");
      setTimeout(() => {
        avatarDropdown.classList.add("hidden");
      }, 200); // match duration
    };

    window.addEventListener("click", (e) => {
      if (!avatarDropdown.classList.contains("hidden") && !avatarDropdown.contains(e.target) && !avatarBtn.contains(e.target)) {
        closeDropdown();
      }
    });
  }

  function Logout() {
    Swal.fire({
      title: "Sign Out",
      text: "Are you sure you want to end your session?",
      icon: "warning",
      showCancelButton: true,
      background: '#111',
      color: '#fff',
      confirmButtonColor: "#dc2626", // red-600
      cancelButtonColor: "#333", // gray-800
      confirmButtonText: "YES, SIGN OUT",
      cancelButtonText: "CANCEL",
      customClass: {
        confirmButton: 'rounded-none font-black tracking-widest',
        cancelButton: 'rounded-none border-0 text-neutral-300 font-bold tracking-wider',
        popup: 'border border-neutral-800 rounded-none'
      }
    }).then((result) => {
      if (result.isConfirmed) {
        if (typeof window.toast !== 'undefined') { window.toast.success("Successfully logged out."); } else { Swal.fire({ title: "Signed Out", text: "See you next time!", icon: "success", timer: 1500, showConfirmButton: false }); } setTimeout(() => { window.location.href = '/user/logout'; }, 1200); //
          .then(() => {
            Swal.fire({
              title: "Signed Out",
              text: "See you next time!",
              icon: "success",
              timer: 1500,
              showConfirmButton: false,
              background: '#111',
              color: '#fff',
              customClass: {
                popup: 'border border-neutral-800 rounded-none'
              }
            });
            setTimeout(() => {
              window.location.href = '/user/login';
            }, 1200);
          })
          .catch(error => {
            console.error("Logout error:", error);
            if (typeof window.toast !== 'undefined') window.toast.error("Logout failed. Try again!");
            else Swal.fire("Error", "Something went wrong. Try again!", "error");
          });
      }
    });
  }
</script>