<header
  class="w-full bg-white bg-opacity-95 backdrop-blur-[20px] sticky top-0 z-[100] border-b border-black/5 transition-all duration-300">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-6">

    <!-- Logo -->
    <a href="/user/home" class="flex items-center gap-1.5 group shrink-0">
      <div
        class="w-8 h-8 bg-black rounded-[10px] flex items-center justify-center transform group-hover:-translate-y-[2px] transition-transform duration-300 shadow-[0_4px_12px_rgba(0,0,0,0.15)]">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </div>
      <span class="font-extrabold text-[22px] tracking-[-0.04em] text-black italic">
        ZOUND
      </span>
    </a>

    <!-- Primary Nav Links -->
    <nav class="hidden md:flex items-center gap-1.5 bg-black/5 p-1 rounded-full">
      <a href="/user/products"
        class="px-5 py-2 rounded-full text-[13px] font-bold tracking-tight text-gray-700 hover:text-black hover:bg-white transition-all duration-300 shadow-[0_2px_10px_rgba(0,0,0,0)] hover:shadow-[0_2px_10px_rgba(0,0,0,0.08)]">Products</a>
      <a href="/user/brands"
        class="px-5 py-2 rounded-full text-[13px] font-bold tracking-tight text-gray-700 hover:text-black hover:bg-white transition-all duration-300 shadow-[0_2px_10px_rgba(0,0,0,0)] hover:shadow-[0_2px_10px_rgba(0,0,0,0.08)]">Brands</a>
      <a href="/user/deals"
        class="px-5 py-2 rounded-full text-[13px] font-bold tracking-tight text-gray-700 hover:text-black hover:bg-white transition-all duration-300 shadow-[0_2px_10px_rgba(0,0,0,0)] hover:shadow-[0_2px_10px_rgba(0,0,0,0.08)]">Deals</a>
      <a href="/user/support"
        class="px-5 py-2 rounded-full text-[13px] font-bold tracking-tight text-gray-700 hover:text-black hover:bg-white transition-all duration-300 shadow-[0_2px_10px_rgba(0,0,0,0)] hover:shadow-[0_2px_10px_rgba(0,0,0,0.08)]">Support</a>
    </nav>

    <!-- Right Side Controls -->
    <div class="flex items-center gap-2 sm:gap-4">

      <!-- Search -->
      <form id="globalSearchForm" action="/user/products" method="GET"
        class="hidden lg:flex items-center relative group">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
          <svg class="w-[18px] h-[18px] text-gray-400 group-focus-within:text-black transition-colors" fill="none"
            stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input id="searchInput" name="search"
          class="w-44 lg:w-56 pl-[38px] pr-4 py-[9px] bg-gray-100 hover:bg-gray-200 focus:bg-white border-2 border-transparent focus:border-black rounded-full text-[13px] font-medium text-black placeholder-gray-500 transition-all duration-300 outline-none"
          placeholder="Search..." autocomplete="off"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
      </form>

      <div class="flex items-center gap-1.5 ml-1">
        <% if (locals.user) { %>
          <!-- Wishlist -->
          <a href="/user/wishlist"
            class="relative p-2.5 rounded-full text-black hover:bg-gray-100 transition-colors duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round" viewBox="0 0 24 24">
              <path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
              </path>
            </svg>
            <% if (typeof wishlistCount !=='undefined' && wishlistCount> 0) { %>
              <span
                class="absolute top-[3px] right-[3px] flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-black text-white text-[10px] font-bold rounded-full border-2 border-white">
                <%= wishlistCount %>
              </span>
              <% } %>
          </a>

          <!-- Cart -->
          <a href="/user/cart"
            class="relative p-2.5 rounded-full text-black hover:bg-gray-100 transition-colors duration-300 mr-1">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
              stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
              <span
                class="absolute top-[3px] right-[3px] flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-black text-white text-[10px] font-bold rounded-full border-2 border-white">
                <%= cartCount %>
              </span>
              <% } %>
          </a>

          <!-- USER AVATAR -->
          <div class="relative flex items-center">
            <button id="avatarBtn"
              class="flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-full transition-transform active:scale-95 duration-200">
              <% if (user.profile_picture) { %>
                <img src="<%= user.profile_picture %>"
                  class="w-[38px] h-[38px] rounded-full object-cover border border-gray-200" />
                <% } else { %>
                  <div
                    class="w-[38px] h-[38px] flex items-center justify-center bg-gray-100 text-black text-[15px] font-bold rounded-full border border-gray-200">
                    <%= user.name.charAt(0).toUpperCase() %>
                  </div>
                  <% } %>
            </button>

            <!-- Dropdown Menu -->
            <div id="avatarDropdown"
              class="hidden absolute right-0 top-[50px] w-64 bg-white/90 backdrop-blur-[25px] border border-black/5 shadow-[0_20px_40px_-10px_rgba(0,0,0,0.15)] rounded-[24px] overflow-hidden z-50 transform origin-top-right transition-all opacity-0 scale-[0.97] translate-y-[-5px] duration-200">
              <div class="p-5 border-b border-black/5">
                <p class="font-extrabold text-[17px] text-black tracking-tight truncate">
                  <%= user.name %>
                </p>
                <p class="text-[13px] font-medium text-gray-500 truncate mt-[2px]">
                  <%= user.email %>
                </p>
              </div>
              <div class="p-2 flex flex-col gap-1">
                <a href="/user/profile"
                  class="flex items-center px-4 py-3 text-[14px] font-bold text-gray-700 hover:text-black hover:bg-black/5 rounded-[16px] transition-colors group">
                  <div
                    class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center mr-3 group-hover:bg-white group-hover:shadow-[0_2px_8px_rgba(0,0,0,0.08)] transition-all">
                    <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </div>
                  My Account
                </a>
                <a href="/user/wishlist"
                  class="flex items-center px-4 py-3 text-[14px] font-bold text-gray-700 hover:text-black hover:bg-black/5 rounded-[16px] transition-colors group">
                  <div
                    class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center mr-3 group-hover:bg-white group-hover:shadow-[0_2px_8px_rgba(0,0,0,0.08)] transition-all">
                    <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                      </path>
                    </svg>
                  </div>
                  Wishlist
                </a>
                <a href="/user/orders"
                  class="flex items-center px-4 py-3 text-[14px] font-bold text-gray-700 hover:text-black hover:bg-black/5 rounded-[16px] transition-colors group">
                  <div
                    class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center mr-3 group-hover:bg-white group-hover:shadow-[0_2px_8px_rgba(0,0,0,0.08)] transition-all">
                    <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  Orders
                </a>
              </div>
              <div class="p-2 border-t border-black/5">
                <button type="button" onclick="Logout()"
                  class="w-full flex items-center justify-center px-4 py-3.5 text-[14px] font-extrabold text-[#FF3B30] hover:bg-[#FF3B30]/10 rounded-[16px] transition-colors active:scale-95 duration-200">
                  Log Out
                </button>
              </div>
            </div>
          </div>

          <% } else { %>
            <!-- Guest view -->
            <a href="/user/cart"
              class="relative p-2.5 rounded-full text-black hover:bg-gray-100 transition-colors duration-300 mr-2">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <% if (typeof cartCount !=='undefined' && cartCount> 0) { %>
                <span
                  class="absolute top-[3px] right-[3px] flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-black text-white text-[10px] font-bold rounded-full border-2 border-white">
                  <%= cartCount %>
                </span>
                <% } %>
            </a>

            <a href="/user/login"
              class="px-6 py-[9px] text-[13.5px] font-bold text-white bg-black hover:bg-gray-800 transition-all duration-300 rounded-full shadow-[0_4px_10px_rgba(0,0,0,0.15)] hover:shadow-[0_6px_15px_rgba(0,0,0,0.2)] hover:-translate-y-0.5 ml-1">
              Sign In
            </a>
            <% } %>

      </div>
    </div>
  </div>
</header>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  // Avatar Dropdown Toggle with Apple-style popup animation
  const avatarBtn = document.getElementById("avatarBtn");
  const avatarDropdown = document.getElementById("avatarDropdown");

  if (avatarBtn) {
    avatarBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = avatarDropdown.classList.contains("hidden");

      if (isHidden) {
        avatarDropdown.classList.remove("hidden");
        setTimeout(() => {
          avatarDropdown.classList.remove("opacity-0", "scale-[0.97]", "translate-y-[-5px]");
          avatarDropdown.classList.add("opacity-100", "scale-100", "translate-y-0");
        }, 10);
      } else {
        closeDropdown();
      }
    });

    const closeDropdown = () => {
      avatarDropdown.classList.remove("opacity-100", "scale-100", "translate-y-0");
      avatarDropdown.classList.add("opacity-0", "scale-[0.97]", "translate-y-[-5px]");
      setTimeout(() => {
        avatarDropdown.classList.add("hidden");
      }, 200);
    };

    window.addEventListener("click", (e) => {
      if (!avatarDropdown.classList.contains("hidden") && !avatarDropdown.contains(e.target) && !avatarBtn.contains(e.target)) {
        closeDropdown();
      }
    });
  }

  function Logout() {
    Swal.fire({
      title: "Log out of ZOUND?",
      text: "You can always log back in at any time.",
      showCancelButton: true,
      confirmButtonColor: "#000000",
      cancelButtonColor: "#f3f4f6",
      confirmButtonText: "Log Out",
      cancelButtonText: "<span style='color:#000; font-weight:700;'>Cancel</span>",
      customClass: {
        popup: 'rounded-[24px] shadow-[0_20px_60px_rgba(0,0,0,0.15)] border border-gray-100 pb-2',
        title: 'font-extrabold text-[22px] tracking-tight mt-4 text-black',
        htmlContainer: 'text-[15px] font-medium text-gray-500 mb-6',
        confirmButton: 'rounded-full font-bold px-8 py-3 text-[14px] w-full mx-0 mt-3',
        cancelButton: 'rounded-full font-bold px-8 py-3 text-[14px] border-0 bg-gray-100 hover:bg-gray-200 w-full mx-0 mt-3',
        actions: 'flex-col gap-0 w-full px-6 pb-2'
      }
    }).then((result) => {
      if (result.isConfirmed) {
        if (typeof window.toast !== 'undefined') { window.toast.success("Successfully logged out."); } else { Swal.fire({ title: "Signed Out", text: "See you next time!", icon: "success", timer: 1500, showConfirmButton: false }); } setTimeout(() => { window.location.href = '/user/logout'; }, 1200); //
          .then(() => {
            if (typeof window.toast !== 'undefined') window.toast.success("Successfully logged out.");
            setTimeout(() => {
              window.location.href = '/user/login';
            }, 600);
          })
          .catch(error => {
            console.error("Logout error:", error);
            if (typeof window.toast !== 'undefined') window.toast.error("Logout failed. Try again!");
            else Swal.fire("Error", "Something went wrong. Try again!", "error");
          });
      }
    });
  }
</script>