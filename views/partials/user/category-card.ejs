<div class="flex flex-col items-center gap-2 card-hover cursor-pointer">
  <div class="w-20 h-20 rounded-full overflow-hidden bg-white shadow 
              flex items-center justify-center category-circle">
    <img src="<%= image %>" alt="<%= name %>" class="w-full h-full object-cover" />
  </div>

  <p class="text-xs font-medium text-neutral-700">
    <%= name %>
  </p>
</div>

