<!-- Category Card Component -->
<div class="flex flex-col items-center gap-2 min-w-[80px] hover:opacity-80 cursor-pointer">
  
  <div class="w-16 h-16 rounded-full overflow-hidden bg-neutral-200">
    <img
      src="<%= image %>"
      alt="<%= name %>"
      class="w-full h-full object-cover"
    />
  </div>

  <p class="text-xs font-medium text-neutral-700 text-center">
    <%= name %>
  </p>

</div>
