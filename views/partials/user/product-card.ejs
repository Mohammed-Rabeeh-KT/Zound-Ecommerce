<div class="bg-white rounded-2xl border p-3 card-hover cursor-pointer">

  <!-- Product Image -->
  <div class="relative w-full h-36 md:h-40 rounded-xl overflow-hidden bg-neutral-100">
    <img src="<%= image %>" alt="<%= name %>"
         class="w-full h-full object-cover" />

    <% if (discount) { %>
      <span class="absolute top-2 left-2 text-[10px] px-2 py-0.5 bg-black text-white rounded-full">
        -<%= discount %>%
      </span>
    <% } %>
  </div>

  <!-- Details -->
  <div class="mt-3 space-y-1">
    <p class="text-xs font-semibold text-neutral-900 leading-none">
      <%= name %>
    </p>

    <% if (brand) { %>
      <p class="text-[11px] text-neutral-500"><%= brand %></p>
    <% } %>

    <!-- Price -->
    <div class="flex items-center gap-2 mt-1">
      <p class="text-sm font-bold text-neutral-900">₹<%= price.toLocaleString() %></p>

      <% if (oldPrice) { %>
        <p class="text-xs line-through text-neutral-400">₹<%= oldPrice.toLocaleString() %></p>
      <% } %>
    </div>
  </div>

</div>
