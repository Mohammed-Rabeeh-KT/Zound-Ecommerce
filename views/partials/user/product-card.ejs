<a href="/user/products/<%= product.slug %>" class="product-card-link">
  <div class="product-card">
    <div class="product-image-container premium-card">
      <!-- PRODUCT IMAGE -->
      <img src="<%= product.listingImage %>" alt="<%= product.productName %>" class="product-image">

      <!-- BADGES -->
      <% if (product.featured) { %>
        <span class="badge badge-featured">Featured</span>
        <% } %>

          <!-- OFFER BADGE - Upper Right (Shows Total Discount %) -->
          <% if (product.offer && product.offer.hasOffer) { %>
            <span class="badge badge-offer">
              <%= product.offer.totalDiscountPercent %>% OFF
            </span>
            <% } else if (product.primaryVariant && product.primaryVariant.basePrice> product.primaryVariant.salePrice)
              { %>
              <span class="badge badge-sale">
                <%= Math.round(((product.primaryVariant.basePrice - product.primaryVariant.salePrice) /
                  product.primaryVariant.basePrice) * 100) %>% OFF
              </span>
              <% } %>

                <!-- ACTION OVERLAY -->
                <div class="card-action-overlay">
                  <% if (product.primaryVariant && product.primaryVariant.stock> 0) { %>
                    <button class="card-btn primary add-to-cart-card-btn" data-product-id="<%= product._id %>"
                      data-variant-id="<%= product.primaryVariant._id %>"
                      onclick="event.preventDefault(); event.stopPropagation(); addToCartQuick('<%= product._id %>', '<%= product.primaryVariant._id %>')">
                      <svg viewBox="0 0 24 24">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39h9.72L23 6H6"></path>
                      </svg>
                      <span>Add to Cart</span>
                    </button>
                    <% } %>

                      <% var cardVariantId='' ; if (product.primaryVariant && product.primaryVariant._id) {
                        cardVariantId=product.primaryVariant._id; } else if (product.variants &&
                        product.variants.length> 0) {
                        cardVariantId = product.variants[0]._id;
                        }
                        %>
                        <button class="card-btn secondary wishlist-btn" data-product-id="<%= product._id %>"
                          data-variant-id="<%= cardVariantId %>"
                          onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist('<%= product._id %>', '<%= cardVariantId %>', this)">
                          <svg class="wishlist-icon" viewBox="0 0 24 24">
                            <path
                              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l7.78-7.78a5.5 5.5 0 0 0 0-7.78z" />
                          </svg>
                        </button>
                </div>
    </div>

    <div class="product-info">
      <div class="product-brand">
        <%= product.brand ? product.brand.brandName : 'ZOUND' %>
      </div>
      <h3 class="product-name">
        <%= product.productName %>
      </h3>

      <!-- PRICING WITH OFFER SUPPORT -->
      <div class="product-pricing">
        <% const displayVariant=product.primaryVariant || (product.variants && product.variants.length> 0 ?
          product.variants[0] : null); %>
          <% if (displayVariant) { %>
            <% if (product.offer && product.offer.hasOffer) { %>
              <span class="current-price">₹<%= product.offer.offerPrice.toLocaleString() %></span>
              <!-- Show BASE PRICE crossed out -->
              <span class="original-price">₹<%= product.offer.basePrice.toLocaleString() %></span>
              <span class="discount-percent">
                <%= product.offer.totalDiscountPercent %>% OFF
              </span>
              <% } else { %>
                <span class="current-price">₹<%= displayVariant.salePrice.toLocaleString() %></span>
                <% if (displayVariant.basePrice> displayVariant.salePrice) { %>
                  <span class="original-price">₹<%= displayVariant.basePrice.toLocaleString() %></span>
                  <% } %>
                    <% } %>
                      <% } else { %>
                        <span class="text-red-500">Price Unavailable</span>
                        <% } %>
      </div>
    </div>
  </div>
</a>