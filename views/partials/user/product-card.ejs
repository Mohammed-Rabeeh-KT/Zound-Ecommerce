<div class="product-card">
  <div class="product-image-container premium-card">
    <!-- PRODUCT IMAGE -->
    <img src="<%= product.listingImage %>" alt="<%= product.productName %>" class="product-image">

    <!-- BADGES (unchanged) -->
    <% if (product.featured) { %>
      <span class="badge badge-featured">Featured</span>
      <% } %>

        <% if (product.originalPrice> product.price) { %>
          <span class="badge badge-sale">Sale</span>
          <% } %>

            <!-- 🔥 PREMIUM IMAGE ACTION OVERLAY (NEW) -->
            <div class="card-action-overlay">

              <% if (product.primaryVariant && product.primaryVariant.stock> 0) { %>
                <button class="card-btn primary" data-product-id="<%= product._id %>">
                  <svg viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39h9.72L23 6H6"></path>
                  </svg>
                  <span>Add to Cart</span>
                </button>
                <% } %>

                  <button class="card-btn secondary" data-product-id="<%= product._id %>">
                    <svg viewBox="0 0 24 24">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67
                              l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78
                              L12 21.23l7.78-7.78a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                  </button>

            </div>
  </div>

  <div class="product-info">
    <div class="product-brand">
      <%= product.brand ? product.brand.brandName : 'ZOUND' %>
    </div>
    <h3 class="product-name">
      <%= product.productName %>
    </h3>
    <!-- <div class="product-rating">
      <div class="stars">
        <% for(let i=1; i <=5; i++) { %>
          <svg class="star <%= i <= Math.floor(product.rating) ? 'filled' : '' %>" width="16" height="16"
            viewBox="0 0 24 24" fill="<%= i <= Math.floor(product.rating) ? '#002366' : 'none' %>" stroke="#002366"
            stroke-width="2">
            <polygon
              points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
            </polygon>
          </svg>
          <% } %>
      </div>
      <span class="rating-text">(<%= product.reviews %>)</span>
    </div> -->
    <div class="product-pricing">
      <% if (product.variants && product.variants.length> 0) { %>
        <span class="current-price">
          ₹<%= product.variants[0].salePrice.toLocaleString() %>
        </span>
        <% if (product.variants[0].basePrice> product.variants[0].salePrice) {
          %>
          <span class="original-price">
            ₹<%= product.variants[0].basePrice.toLocaleString() %>
          </span>
          <% } %>
            <% } else { %>
              <span class="text-red-500">Price Unavailable</span>
              <% } %>
    </div>
    <a href="/user/products/<%= product.slug %>" class="view-details-btn">View Details</a>
  </div>
</div>