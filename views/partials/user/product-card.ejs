<article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-200 group cursor-pointer flex flex-col">

  <!-- Product Image -->
  <div class="relative">
    <img
      src="<%= image %>"
      alt="<%= name %>"
      class="w-full h-44 object-cover"
    />

    <!-- Discount Badge -->
    <% if (discount) { %>
      <span class="absolute top-2 right-2 bg-red-500 text-white text-[11px] px-2 py-1 rounded-full">
        <%= discount %>%
      </span>
    <% } %>
  </div>

  <!-- Product Info -->
  <div class="px-3 py-3 flex-1 flex flex-col">
    <p class="text-[11px] text-neutral-500"><%= brand %></p>

    <h3 class="text-sm font-semibold text-neutral-900 mt-1 line-clamp-2">
      <%= name %>
    </h3>

