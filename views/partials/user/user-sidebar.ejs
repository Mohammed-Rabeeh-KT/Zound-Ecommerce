<aside class="premium-sidebar">
    <div class="sidebar-header">
        <div class="user-avatar-container">
            <img src="<%= user.profile_picture || 'https://ui-avatars.com/api/?name=' + user.name + '&background=002366&color=fff' %>"
                alt="User" class="avatar-img">
        </div>
        <div class="user-info">
            <h3 class="user-name">
                <%= user.name %>
            </h3>
            <p class="user-email">
                <%= user.email %>
            </p>
        </div>
    </div>

    <nav class="sidebar-menu">
        <div class="menu-section">
            <span class="menu-title">Manage Account</span>

            <a href="/user/profile"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'profile' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Personal Information</span>
            </a>

            <a href="/user/profile/edit"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'edit-profile' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <span>Edit Profile</span>
            </a>

            <a href="/user/profile/addresses"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'addresses' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Addresses</span>
            </a>

            <a href="/user/profile/reviews"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'reviews' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon
                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                    </polygon>
                </svg>
                <span>My Reviews</span>
            </a>

            <a href="/user/profile/referrals"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'referrals' ? 'active' : '' %>">
                <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Referrals</span>
            </a>

            <a href="/user/profile/questions"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'questions' ? 'active' : '' %>">
                <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span>Questions & Answers</span>
            </a>
        </div>

        <div class="menu-section">
            <span class="menu-title">Orders & Wallet</span>

            <a href="/user/orders"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'orders' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>Orders</span>
            </a>

            <a href="/user/wishlist"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'wishlist' ? 'active' : '' %>">
                <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                    </path>
                </svg>
                <span>Wishlist</span>
            </a>

            <a href="/user/wallet"
                class="menu-item <%= typeof currentPage !== 'undefined' && currentPage === 'wallet' ? 'active' : '' %>">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                <span>Wallet</span>
            </a>
        </div>

        <div class="menu-section bottom">
            <a href="/user/logout" class="menu-item logout">
                <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Logout</span>
            </a>
        </div>
    </nav>
</aside>

<style>
    /* --- Premium Sidebar --- */
    .premium-sidebar {
        position: sticky;
        top: 40px;
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08);
        border: 1px solid #f3f4f6;
    }

    .sidebar-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .user-avatar-container {
        width: 90px;
        height: 90px;
        margin: 0 auto 16px;
        border-radius: 50%;
        padding: 3px;
        border: 1px solid #e2e8f0;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-name {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 4px 0;
        color: #0f172a;
    }

    .user-email {
        font-size: 0.85rem;
        color: #64748b;
        margin: 0;
    }

    /* Sidebar Menu */
    .menu-section {
        margin-bottom: 30px;
    }

    .menu-title {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 12px;
        padding-left: 12px;
        font-weight: 600;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
        color: #64748b;
        font-weight: 500;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .menu-icon {
        width: 20px;
        height: 20px;
        stroke-width: 1.8;
    }

    /* Sidebar Interactions */
    .menu-item:hover {
        background-color: #eef2ff;
        color: #002366;
    }

    .menu-item.active {
        background-color: #002366;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(0, 35, 102, 0.2);
    }

    .menu-item.logout {
        color: #ef4444;
    }

    .menu-item.logout:hover {
        background-color: #fef2f2;
    }
</style>