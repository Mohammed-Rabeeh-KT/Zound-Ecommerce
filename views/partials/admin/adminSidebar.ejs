<link rel="stylesheet" href='/styles/admin/adminsidebar.css' />
<aside class="admin-sidebar">

    <!-- HEADER -->
    <div class="sidebar-header">
        <i data-lucide="headphones" class="logo-icon"></i>
        <div>
            <h2 class="sidebar-title">ZOUND</h2>
            <p class="sidebar-subtitle">Admin Dashboard</p>
        </div>
    </div>

    <div class="sidebar-divider"></div>

    <!-- MENU -->
    <nav class="sidebar-menu">

        <a href="/admin/dashboard" class="menu-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
            <i data-lucide="layout-dashboard"></i> Dashboard
        </a>

        <a href="/admin/users" class="menu-item <%= currentPage === 'users' ? 'active' : '' %>">
            <i data-lucide="users"></i> Users
        </a>

        <a href="/admin/products" class="menu-item <%= currentPage === 'products' ? 'active' : '' %>">
            <i data-lucide="box"></i> Products
        </a>

        <a href="/admin/categories" class="menu-item <%= currentPage === 'categories' ? 'active' : '' %>">
            <i data-lucide="layers"></i> Categories
        </a>

        <a href="/admin/brands" class="menu-item <%= currentPage === 'brands' ? 'active' : '' %>">
            <i data-lucide="tag"></i> Brands
        </a>

        <a href="/admin/orders" class="menu-item <%= currentPage === 'orders' ? 'active' : '' %>">
            <i data-lucide="shopping-cart"></i> Orders
        </a>

        <a href="/admin/payments" class="menu-item <%= currentPage === 'payments' ? 'active' : '' %>">
            <i data-lucide="credit-card"></i> Payments
        </a>

        <a href="/admin/coupons" class="menu-item <%= currentPage === 'coupons' ? 'active' : '' %>">
            <i data-lucide="ticket"></i> Coupons
        </a>

        <!-- <a href="/admin/support" class="menu-item <%= currentPage === 'support' ? 'active' : '' %>">
            <i data-lucide="headset"></i> Support
        </a> -->

        <a href="/admin/referrals" class="menu-item <%= currentPage === 'referrals' ? 'active' : '' %>">
            <i data-lucide="user-plus"></i> Referrals
        </a>

        <a href="/admin/sales" class="menu-item <%= currentPage === 'sales' ? 'active' : '' %>">
            <i data-lucide="bar-chart-3"></i> Sales
        </a>

        <a href="/admin/offers" class="menu-item <%= currentPage === 'offers' ? 'active' : '' %>">
            <i data-lucide="gift"></i> Offers
        </a>

        <a href="/admin/reviews" class="menu-item <%= currentPage === 'reviews' ? 'active' : '' %>">
            <i data-lucide="star"></i> Reviews
        </a>

        <a href="/admin/banners" class="menu-item <%= currentPage === 'banners' ? 'active' : '' %>">
            <i data-lucide="flag"></i> Banners
        </a>

    </nav>

    <div class="sidebar-divider"></div>

    <!-- FOOTER -->
    <div class="sidebar-footer">
        <div class="sidebar-admin-profile">
            <div class="avatar">
                <%= adminName ? adminName.substring(0,2).toUpperCase() : "AN" %>
            </div>
            <div>
                <p class="admin-name">
                    <%= adminName || "Admin Name" %>
                </p>
                <p class="admin-email">Administrator</p>
            </div>
        </div>

        <a href="/admin/logout" class="logout-btn">
            <i data-lucide="log-out"></i> Logout
        </a>
    </div>

</aside>


<script>
    lucide.createIcons();
</script>