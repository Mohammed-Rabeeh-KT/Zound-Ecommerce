<style>
    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: none;
        justify-content: center;
        align-items: center;
    }

    .modal-overlay.show {
        display: flex;
        animation: fadeIn 0.2s;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .modal-container {
        background: white;
        width: 900px;
        max-width: 95vw;
        max-height: 90vh;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .modal-header {
        padding: 20px 30px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        z-index: 10;
    }

    .modal-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--secondary);
    }

    .modal-body {
        padding: 30px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 30px;
        border-top: 1px solid var(--border);
        background: white;
    }

    /* Form Styles */
    .form-section {
        margin-bottom: 30px;
    }

    .section-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--secondary);
        margin-bottom: 15px;
        display: block;
        border-left: 3px solid var(--secondary);
        padding-left: 10px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 500;
        color: var(--text-dark);
    }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-family: inherit;
        font-size: 14px;
        transition: border-color 0.2s;
        box-sizing: border-box;
        /* Ensure padding doesn't affect width */
    }

    .form-input:focus,
    .form-select:focus,
    .form-textarea:focus {
        outline: none;
        border-color: var(--secondary);
    }

    /* Image Upload */
    .upload-area {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        background: #f8fafc;
    }

    .upload-area:hover,
    .upload-area.dragover {
        border-color: var(--secondary);
        background: #eff6ff;
    }

    .upload-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .image-preview {
        /* Matches JS class */
        position: relative;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .remove-img {
        position: absolute;
        top: 4px;
        right: 4px;
        background: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Tom Select Overrides */
    .ts-wrapper.single .ts-control {
        border: 1px solid var(--border) !important;
        border-radius: 8px !important;
        padding: 12px !important;
        box-shadow: none !important;
        background: transparent !important;
        font-size: 14px !important;
        color: var(--text-dark) !important;
        min-height: auto !important;
        height: auto !important;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 30px;
        color: var(--text-light);
        background: #f8fafc;
        border-radius: 12px;
        border: 1px dashed var(--border);
    }

    /* Buttons */
    .btn-primary {
        background: var(--secondary);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
    }

    .btn-secondary {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-dark);
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
    }

    /* Image Preview Styles */
    .upload-preview-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 15px;
    }

    .image-preview {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .remove-img {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(255, 0, 0, 0.8);
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
        padding: 0;
        transition: all 0.2s;
    }

    .remove-img:hover {
        background: #ff0000;
        transform: scale(1.1);
    }

    /* For the variant images */
    .upload-preview-item {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .upload-preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .remove-btn {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(255, 0, 0, 0.8);
        color: white;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        line-height: 1;
        padding: 0;
        transition: all 0.2s;
    }

    .remove-btn:hover {
        background: #ff0000;
        transform: scale(1.1);
    }
</style>

<!-- ADD/EDIT MODAL -->
<div class="modal-overlay" id="productModal">
    <div class="modal-container">
        <div class="modal-header">
            <h2 class="modal-title" id="modalTitle">Add New Product</h2>
            <button type="button" class="action-btn" onclick="closeModal()" style="border:none;"><i
                    class="bi bi-x-lg"></i></button>
        </div>

        <div class="modal-body">
            <form id="productForm">
                <input type="hidden" id="productId">

                <!-- Step 1: Basic Info -->
                <span class="section-label">Basic Information</span>

                <!-- Product Name (Full Width) -->
                <div class="form-group">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="productName" class="form-input" placeholder="e.g. Sony WH-1000XM5">
                </div>

                <!-- Category & Brand (Side by Side) -->
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="category" id="categorySelect">
                            <option value="">Select Category</option>
                            <% if(locals.categories) { %>
                                <% categories.forEach(cat=> { %>
                                    <option value="<%= cat._id %>">
                                        <%= cat.name %>
                                    </option>
                                    <% }) %>
                                        <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Brand</label>
                        <select name="brand" id="brandSelect">
                            <option value="">Select Brand</option>
                            <% if(locals.brands) { %>
                                <% brands.forEach(brand=> { %>
                                    <option value="<%= brand._id %>">
                                        <%= brand.brandName %>
                                    </option>
                                    <% }) %>
                                        <% } %>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-textarea" rows="4"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <!-- Step 2: Key Features -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <span class="section-label" style="margin:0;">Key Features</span>
                    <button type="button" onclick="addFeature()" class="btn-primary"
                        style="background:#eff6ff; color:var(--secondary); border:none; padding:8px 16px; font-size:13px;">
                        <i class="bi bi-plus-lg"></i> Add Feature
                    </button>
                </div>
                <div id="featuresContainer">
                    <div class="empty-state">No features added yet. Click "Add Feature" to get started.</div>
                </div>

                <hr style="border:0; border-top:1px solid var(--border); margin: 30px 0;">

                <!-- Step 3: Images -->
                <span class="section-label">Product Images (Min 1)</span>
                <div class="upload-area" id="imageDropZone">
                    <i class="bi bi-cloud-arrow-up" style="font-size: 32px; color: var(--secondary);"></i>
                    <p style="margin: 10px 0; color: var(--text-light);">Drag & Drop images here or click to
                        browse</p>
                    <input type="file" id="imageFileInput" multiple accept="image/*" style="display:none">
                    <button type="button" onclick="document.getElementById('imageFileInput').click()"
                        class="btn-primary" style="display:inline-flex;">Browse Files</button>
                </div>
                <div class="upload-preview-grid" id="imagePreviewContainer"></div>

                <hr style="border:0; border-top:1px solid var(--border); margin: 30px 0;">

                <!-- Step 4: Variants -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <span class="section-label" style="margin:0;">Product Variants</span>
                    <button type="button" onclick="openVariantModal()" class="btn-primary"
                        style="background:#eff6ff; color:var(--secondary); border:none; padding:8px 16px; font-size:13px;">
                        <i class="bi bi-plus-lg"></i> Add Variant
                    </button>
                </div>

                <div id="variantsContainer">
                    <div class="empty-state">No variants added yet. Click "Add Variant" to get started.</div>
                </div>

            </form>
        </div>

        <div class="modal-footer"
            style="padding:20px 30px; border-top:1px solid var(--border); background:white; display:flex; justify-content:flex-end; gap:12px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
            <button type="button" onclick="closeModal()" class="btn-secondary">Cancel</button>
            <button type="button" onclick="submitProduct(event)" class="btn-primary">Save Product</button>
        </div>
    </div>
</div>

<!-- ADD/EDIT VARIANT MODAL -->
<div class="modal-overlay" id="variantModal" style="z-index: 1050;">
    <div class="modal-container" style="width: 540px; max-height: 90vh;">
        <div class="modal-header">
            <h2 class="modal-title" id="variantModalTitle">Add Variant</h2>
            <button type="button" class="action-btn" onclick="closeVariantModal()" style="border:none;"><i
                    class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body" style="padding: 24px;">
            <form id="variantForm">
                <input type="hidden" id="variantIndex">

                <!-- Variant Type -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Variant Type
                        *</label>
                    <input type="text" name="v_type" class="form-input" placeholder="e.g., Color, Size, Storage"
                        style="width: 100%;">
                </div>

                <!-- Variant Value -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Variant
                        Value *</label>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <input type="text" name="v_value" class="form-input" placeholder="e.g., Black, XL, 128GB"
                            style="flex: 1;">
                        <div id="colorPreview"
                            style="width:36px; height:36px; border-radius:8px; border:1px solid var(--border); display:none;">
                        </div>
                    </div>
                </div>

                <!-- Variant Image Upload -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Variant
                        Image *</label>

                    <div class="upload-area" onclick="document.getElementById('variantImageInput').click()"
                        id="variantDropZone"
                        style="padding: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px; transition: all 0.2s;">
                        <i class="bi bi-cloud-arrow-up"
                            style="font-size: 32px; color: var(--secondary); margin-bottom: 12px;"></i>
                        <p style="text-align:center; margin: 0; font-size: 14px; color: var(--text-light);">Drag & drop
                            or click to
                            upload</p>
                        <button type="button" class="btn-primary" style="margin-top:10px; pointer-events:none;">Browse
                            Files</button>
                    </div>

                    <input type="file" id="variantImageInput" accept="image/*" multiple style="display:none"
                        onchange="handleVariantImageSelect(this)">

                    <div class="upload-preview-grid" id="variantPreviewContainer" style="margin-top:15px;">
                        <!-- Variant Images Grid -->
                    </div>
                </div>

                <!-- Base Price & Selling Price (Grid) -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                    <div class="form-group">
                        <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Base
                            Price *</label>
                        <input type="number" name="v_basePrice" class="form-input" placeholder="0.00"
                            oninput="calculateFromPrice()" step="0.01" min="0" style="width: 100%;">
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Selling
                            Price
                            *</label>
                        <input type="number" name="v_salePrice" class="form-input" placeholder="0.00"
                            oninput="calculateFromPrice()" step="0.01" min="0" style="width: 100%;">
                    </div>
                </div>

                <!-- Offer Percentage (Editable) -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Offer
                        Percentage</label>
                    <div style="position:relative;">
                        <input type="number" name="v_offer" class="form-input" placeholder="0"
                            oninput="calculateFromDiscount()" step="0.01" min="0" max="100"
                            style="width: 100%; padding-right: 40px;">
                        <span
                            style="position:absolute; right:15px; top:50%; transform: translateY(-50%); color:var(--text-light); font-weight: 500;">%</span>
                    </div>
                </div>

                <!-- Stock -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label" style="margin-bottom: 8px; display: block; font-weight: 500;">Stock
                        *</label>
                    <input type="number" name="v_stock" class="form-input" placeholder="0" min="0" style="width: 100%;">
                </div>

                <!-- Variant Status -->
                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label"
                        style="margin-bottom: 8px; display: block; font-weight: 500;">Status</label>
                    <div style="position: relative;">
                        <select id="variantStatus" class="form-select" style="width: 100%;">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <i class="bi bi-chevron-down"
                            style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #64748b;"></i>
                    </div>
                </div>

                <!-- Discount Amount Display -->
                <div id="discountContainer"
                    style="background:#f1f5f9; padding:16px 20px; border-radius:8px; display:none; justify-content:space-between; align-items:center; margin-bottom: 0;">
                    <span style="font-weight:600; color:#64748b; font-size: 14px;">Discount Amount:</span>
                    <span style="font-weight:700; font-size:18px; color: #002366;" id="discountAmount">₹0.00</span>
                </div>
            </form>
        </div>
        <div class="modal-footer"
            style="background:#fff; padding: 20px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 12px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
            <button type="button" onclick="closeVariantModal()" class="btn-secondary">Cancel</button>
            <button type="button" onclick="saveVariant()" class="btn-primary">Save Variant</button>
        </div>
    </div>
</div>


<!-- CROPPER MODAL -->
<div class="modal-overlay" id="cropperModal" style="z-index: 1060;">
    <div class="modal-container" style="width: 800px; height: 600px;">
        <div class="modal-header">
            <h2 class="modal-title">Crop Image</h2>
            <button type="button" class="action-btn" onclick="closeCropper()" style="border:none;"><i
                    class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body"
            style="padding:0; overflow:hidden; background:#000; height: 450px; display: flex; justify-content: center; align-items: center;">
            <img id="cropperImage" style="max-width:100%; max-height: 100%; display:block;">
        </div>
        <div class="modal-footer"
            style="background:#fff; padding: 15px 24px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" onclick="closeCropper()" class="btn-secondary">Skip / Cancel</button>
            <button type="button" onclick="saveCrop()" class="btn-primary">Crop & Save</button>
        </div>
    </div>
</div>