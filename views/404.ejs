<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found - Zound</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f4f6;
        }

        .error-card {
            max-width: 440px;
            width: 90%;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            padding: 48px 36px;
            text-align: center;
        }

        .error-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            color: #9ca3af;
        }

        .error-code {
            font-size: 64px;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .error-message {
            font-size: 20px;
            font-weight: 600;
            color: #4b5563;
            margin-bottom: 12px;
        }

        .error-desc {
            font-size: 14px;
            color: #9ca3af;
            margin-bottom: 28px;
        }

        .error-btn {
            display: inline-block;
            background: #2563eb;
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            padding: 12px 28px;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.2s;
        }

        .error-btn:hover {
            background: #1d4ed8;
        }
    </style>
</head>

<body>
    <div class="error-card">
        <svg class="error-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h1 class="error-code">404</h1>
        <h2 class="error-message">Page Not Found</h2>
        <p class="error-desc">Sorry, we couldn't find the page you're looking for.</p>
        <a href="<%= typeof isAdmin !== 'undefined' && isAdmin ? '/admin/dashboard' : '/' %>"
            class="error-btn">
            <%= typeof isAdmin !=='undefined' && isAdmin ? 'Go to Dashboard' : 'Return to home' %>
        </a>
    </div>
</body>

</html>